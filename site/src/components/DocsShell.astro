---
import VersionSelector from './VersionSelector.astro';
import { getVersion, getVersions, type KoiVersion } from '../lib/versions';
import { versionIndexes, versionDestinations } from '../lib/documentation';
import { versionDestination } from '../lib/version-navigation';
import Base from '../layouts/Base.astro';
import Brand from './Brand.astro';
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';
import Search from './Search.astro';
import KoiMark from './KoiMark.astro';
import HumanNote from './HumanNote.astro';
import { getDocs } from '../lib/content';
interface Props {
  version?: KoiVersion;
  selected: { id: string; title: string; description: string; url: string };
}
const { selected, version = getVersion() } = Astro.props;
const docsIndexes = versionIndexes(version);
const destinations = await versionDestinations();
const source = destinations.find((entry) => entry.id === version.id)!;
const options = getVersions().map((target) => ({
  id: target.id,
  label: target.label,
  href: versionDestination(
    source,
    destinations.find((entry) => entry.id === target.id)!,
    selected.url,
  ),
  tooltip:
    target.id === 'unreleased'
      ? 'Subject to change without notice. Use at your own risk.'
      : undefined,
}));
const versionOptions = [
  ...options,
  {
    id: 'legacy',
    label: 'v1.x',
    href: 'https://old.willcarhart.dev/docs/koi',
    external: true,
    tooltip: 'Koi v1 is no longer supported.',
  },
];
const docs = await getDocs(version);
const groups = [...new Set(docs.map((d) => d.group))];
---

<Base
  documentationVersion={version}
  title={`${selected.title} — Documentation`}
  description={selected.description}
  class="docs-page"
>
  <div class="docs-mobile-bar">
    <Brand />
    <VersionSelector
      id="mobile-version"
      align="end"
      value={version.id}
      options={versionOptions}
    />
    <button
      type="button"
      class="icon-button"
      data-open-menu
      aria-label="Open documentation menu"
      aria-controls="docs-sidebar"
      aria-expanded="false"
    >
      <Icon name="menu" />
    </button>
  </div>
  <button
    class="sidebar-backdrop"
    type="button"
    data-close-menu
    aria-label="Close documentation menu"
    tabindex="-1"
  ></button>
  <aside
    id="docs-sidebar"
    class="docs-sidebar"
    aria-label="Documentation sidebar"
  >
    <div class="sidebar-brand">
      <Brand />
      <ThemeToggle />
      <button
        type="button"
        class="icon-button mobile-close"
        data-close-menu
        aria-label="Close documentation menu"
      >
        <Icon name="close" />
      </button>
    </div>
    <div class="sidebar-label">
      <VersionSelector
        id="sidebar-version"
        align="end"
        value={version.id}
        options={versionOptions}
      />
    </div>
    <button class="search-trigger" type="button" data-open-search>
      <Icon name="search" />
      <span>Search docs</span>
      <kbd>/</kbd>
    </button>
    <nav aria-label="Documentation sections">
      {groups.map((group) => {
        const index = docsIndexes.find((index) => index.group === group);
        return (
          <div class="nav-group">
            <p>
              {index ? (
                <a
                  class="nav-group-link"
                  href={index.url}
                  data-doc-link={index.id}
                  aria-current={selected.url === index.url ? 'page' : undefined}
                >
                  {group}
                </a>
              ) : (
                group
              )}
            </p>
            {docs
              .filter((d) => d.group === group)
              .map((doc) => (
                <a
                  class:list={{
                    'nav-code':
                      doc.group === 'Reference' &&
                      doc.title.startsWith('koi::'),
                  }}
                  href={`${doc.url}#${doc.id}`}
                  data-doc-link={doc.id}
                  aria-current={doc.id === selected.id ? 'location' : undefined}
                >
                  <span>{doc.navTitle ?? doc.title}</span>
                </a>
              ))}
          </div>
        );
      })}
    </nav>
    <div class="sidebar-bottom">
      <a href="/install">Install</a>
      <a href="/playground">Terminal</a>
      <a
        href="https://github.com/wcarhart/koi"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub <span>↗</span>
      </a>
      <HumanNote />
    </div>
  </aside>
  <main id="main" class="docs-main" data-initial-section={selected.id}>
    <noscript>
      <p class="no-script-note">
        Reading without JavaScript.{' '}
        <a href={`#${selected.id}`}>Jump to {selected.title}</a>.
      </p>
    </noscript>
    <div class="docs-topline">
      <span class="docs-joke">
        <span class="status-dot" aria-hidden="true"></span>
        <span>
          <span class="docs-joke-question">
            Why did the fish prefer the smaller pond?
          </span>{' '}
          <span>Because he was feeling a little koi.</span>
        </span>
      </span>
      <a href="/" aria-label="Koi home">
        <KoiMark variant="outline" />
      </a>
    </div>
    <slot />
    <footer class="docs-footer">
      <a href="/">koishell.com</a>
      <KoiMark variant="filled" />
    </footer>
  </main>
  <aside
    id="ask-koi"
    class="ask-koi-pane"
    aria-labelledby="ask-koi-title"
    inert
  >
    <div class="ask-koi-heading">
      <h2 id="ask-koi-title">Ask koi</h2>
      <button
        type="button"
        class="icon-button"
        data-close-ask
        aria-label="Close Ask koi"
      >
        <Icon name="close" />
      </button>
    </div>
    <div class="ask-koi-placeholder">
      <Icon name="chat" />
      <h3>Coming soon</h3>
      <p>Ask koi is under construction. A chat interface is on its way.</p>
    </div>
  </aside>
  <Search
    indexUrl={
      version.id === 'unreleased'
        ? '/search.json'
        : `${version.base}/search.json`
    }
  />
  <script
    id="documentation-versions"
    type="application/json"
    set:html={JSON.stringify(destinations).replaceAll('<', '\\u003c')}
  />
  <script>
    import '../scripts/docs';
    import '../scripts/docs-versions';
  </script>
</Base>
