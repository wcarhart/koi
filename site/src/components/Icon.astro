---
import claudeCodeSvg from '../assets/icons/claude-code.svg?raw';
import copilotSvg from '../assets/icons/copilot.svg?raw';
import antigravitySvg from '../assets/icons/antigravity.svg?raw';
import gooseSvg from '../assets/icons/goose.svg?raw';
import codexSvg from '../assets/icons/codex.svg?raw';
import opencodeSvg from '../assets/icons/opencode.svg?raw';
import cursorSvg from '../assets/icons/cursor.svg?raw';
import chatSvg from '../assets/icons/chat.svg?raw';
import openaiSvg from '../assets/icons/openai.svg?raw';
import claudeSvg from '../assets/icons/claude.svg?raw';
import markdownSvg from '../assets/icons/markdown.svg?raw';
import agentSvg from '../assets/icons/agent.svg?raw';
import lightModeSvg from '../assets/icons/light-mode.svg?raw';
import nightModeSvg from '../assets/icons/night-mode.svg?raw';
import resetSvg from '../assets/icons/reset.svg?raw';

interface Props {
  name:
    | 'arrow'
    | 'sun'
    | 'moon'
    | 'pause'
    | 'play'
    | 'reset'
    | 'search'
    | 'menu'
    | 'close'
    | 'github'
    | 'agent'
    | 'chat'
    | 'markdown'
    | 'more'
    | 'warning'
    | 'openai'
    | 'claude'
    | 'codex'
    | 'opencode'
    | 'cursor'
    | 'claude-code'
    | 'copilot'
    | 'antigravity'
    | 'goose';
}
const { name } = Astro.props;
const paths = {
  pause: 'M8 5v14M16 5v14',
  play: 'M8 5l11 7-11 7Z',
  more: 'M5 12h.01M12 12h.01M19 12h.01',
  warning: 'm12 3 10 18H2ZM12 9v5m0 3h.01',
  arrow: 'M5 12h14m-6-6 6 6-6 6',
  search: 'm20 20-4.5-4.5M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0',
  menu: 'M4 6h16M4 12h16M4 18h16',
  close: 'm6 6 12 12M6 18 18 6',
  github:
    'M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656',
};
const customSvg = {
  'claude-code': claudeCodeSvg,
  copilot: copilotSvg,
  antigravity: antigravitySvg,
  goose: gooseSvg,
  codex: codexSvg,
  opencode: opencodeSvg,
  cursor: cursorSvg,
  chat: chatSvg,
  openai: openaiSvg,
  claude: claudeSvg,
  markdown: markdownSvg,
  agent: agentSvg,
  sun: lightModeSvg,
  moon: nightModeSvg,
  reset: resetSvg,
};
const svg =
  name in customSvg ? customSvg[name as keyof typeof customSvg] : undefined;
const iconPath = name in paths ? paths[name as keyof typeof paths] : undefined;
---

{svg ? (
  <Fragment set:html={svg} />
) : (
  <svg
    width="20"
    height="20"
    viewBox={name === 'github' ? '0 0 16 16' : '0 0 24 24'}
    fill={name === 'github' ? 'currentColor' : 'none'}
    stroke={name === 'github' ? 'none' : 'currentColor'}
    stroke-width={name === 'more' ? '3' : '1.5'}
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d={iconPath} />
  </svg>
)}
