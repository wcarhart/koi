---
import {
  getBuilderProfile,
  type BuilderProfileId,
} from '../lib/builder-profiles';
interface Props {
  profile?: BuilderProfileId;
}
const { profile = 'v2-initial' } = Astro.props;
const settings = getBuilderProfile(profile)!;
import Dropdown from './Dropdown.astro';
import ExplorerPanel from './ExplorerPanel.astro';
import ExplorerHeading from './ExplorerHeading.astro';
import ExplorerAction from './ExplorerAction.astro';
import ExplorerEditorActions from './ExplorerEditorActions.astro';
import ToggleSwitch from './ToggleSwitch.astro';
---

<ExplorerPanel kind="argument" profile={profile}>
  <div data-argument-list>
    <ExplorerHeading
      title="Register arguments"
      resetLabel="Reset arguments"
      subtitle="Configure flags, options, and positional arguments."
    />
    <ul class="argument-rows" aria-label="Registered arguments"></ul>
    <div class="argument-actions">
      <ExplorerAction label="Register an argument" action="add" icon="add" />
    </div>
  </div>
  <form
    data-argument-editor
    aria-label="Argument code builder"
    hidden
    novalidate
  >
    <h3 class="argument-subtitle" data-editor-title>
      Register an argument
    </h3>
    <label for="argument-destination">Destination variable</label>
    <input
      id="argument-destination"
      name="destination"
      required
      spellcheck="false"
      autocomplete="off"
    />
    <Dropdown
      id="argument-kind"
      label="Kind"
      options={settings.argumentKinds}
    />
    <div data-cardinality>
      <Dropdown
        id="argument-cardinality"
        label="Cardinality"
        options={settings.cardinalities}
      />
    </div>
    <div class="field-pair" data-spellings>
      <div>
        <label for="argument-short">
          Short name <span class="muted">(optional)</span>
        </label>
        <input id="argument-short" name="short" spellcheck="false" />
      </div>
      <div>
        <label for="argument-long">
          Long name <span class="muted">(optional)</span>
        </label>
        <input id="argument-long" name="long" spellcheck="false" />
      </div>
    </div>
    <div data-default-control>
      <ToggleSwitch
        id="argument-use-default"
        name="useDefault"
        label="Use a default"
        changeHook="useDefault"
        labelFirst
      />
      <div data-default-value hidden>
        <label for="argument-default">Default value</label>
        <input id="argument-default" name="defaultValue" />
      </div>
    </div>
    <div data-display-name>
      <label for="argument-display">
        Display name <span class="muted">(optional)</span>
      </label>
      <input id="argument-display" name="displayName" />
    </div>
    <label for="argument-description">Description</label>
    <textarea
      id="argument-description"
      name="description"
      rows="2"
      required
    ></textarea>
    <ToggleSwitch
      id="argument-required"
      name="required"
      label="Required"
      changeHook="required"
      labelFirst
    />
    <ExplorerEditorActions saveLabel="Save argument" />
  </form>
</ExplorerPanel>
