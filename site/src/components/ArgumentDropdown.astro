---
interface Props {
  name: string;
  label: string;
  options: string[];
}
const { name, label, options } = Astro.props;
---

<div data-argument-dropdown={name}>
  <label id={`argument-${name}-label`}>{label}</label>
  <div class="argument-dropdown">
    <button
      type="button"
      class={`argument-dropdown-trigger argument-${name}-trigger`}
      aria-haspopup="listbox"
      aria-expanded="false"
      aria-labelledby={`argument-${name}-label argument-${name}-value`}
    >
      <span id={`argument-${name}-value`}>{options[0]}</span>
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
      >
        <path d="m7 10 5 5 5-5" />
      </svg>
    </button>
    <div role="listbox" aria-labelledby={`argument-${name}-label`} hidden>
      {options.map((option, index) => (
        <button
          type="button"
          role="option"
          aria-selected={index === 0 ? 'true' : 'false'}
          data-value={option.toLowerCase()}
          tabindex="-1"
        >
          {option}
        </button>
      ))}
    </div>
  </div>
</div>
