---
import resetIcon from '../assets/icons/reset.svg?raw';
interface Props {
  label: string;
  action?: string;
  icon: 'add' | 'cancel' | 'save' | 'reset';
  type?: 'button' | 'submit';
}
const { label, action, icon, type = 'button' } = Astro.props;
const paths = {
  add: 'M12 5v14M5 12h14',
  cancel: 'm6 6 12 12M6 18 18 6',
  save: 'm5 12 4 4L19 6',
};
---

<button
  type={type}
  class:list={[
    'argument-action',
    { destructive: icon === 'reset', success: icon === 'save' },
  ]}
  aria-label={label}
  title={label}
  data-action={action}
  data-reset={action === 'reset' ? '' : undefined}
  data-add={action === 'add' ? '' : undefined}
  data-cancel={action === 'cancel' ? '' : undefined}
>
  {icon === 'reset' ? (
    <Fragment set:html={resetIcon} />
  ) : (
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      aria-hidden="true"
    >
      <path d={paths[icon]} />
    </svg>
  )}
</button>
