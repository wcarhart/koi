---
import Icon from './Icon.astro';
import { copyIcon, type Doc } from '../lib/content';
import { docActionLinks } from '../lib/doc-actions';
interface Props {
  doc: Doc;
  index: number;
}
const { doc, index } = Astro.props;
const links = docActionLinks(doc.url);
const controls = [
  { key: 'ask', label: 'Ask about this doc', icon: 'chat' },
  { key: 'copy', label: 'Copy doc as Markdown', icon: 'copy' },
  { key: 'markdown', label: 'View doc as Markdown', icon: 'markdown' },
  { key: 'more', label: 'More doc actions', icon: 'more' },
] as const;
---

<div class="doc-toolbar-anchor" aria-hidden="true"></div>
<div class="section-toolbar article-toolbar" data-doc-toolbar>
  <div class="doc-toolbar-context">
    <span class="section-number">
      <span class="section-number-badge">
        {String(index + 1).padStart(2, '0')}
      </span>
      <span class="doc-breadcrumb">
        <span class="section-number-prefix">{doc.group} /</span>{' '}
        {doc.navTitle ?? doc.title}
      </span>
    </span>
  </div>
  <div class="doc-actions">
    <div class="doc-control" data-tooltip>
      <span
        class="doc-progress"
        role="progressbar"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        tabindex="0"
        aria-label="Reading progress: 0%"
        aria-describedby={`${doc.id}-progress-tip`}
      >
        <svg viewBox="0 0 40 40" aria-hidden="true">
          <circle class="progress-track" cx="20" cy="20" r="19" />
          <circle
            class="progress-arc"
            cx="20"
            cy="20"
            r="19"
            pathLength="100"
          />
        </svg>
      </span>
      <span
        class="doc-tooltip"
        role="tooltip"
        id={`${doc.id}-progress-tip`}
        data-progress-tooltip
      >
        You are 0% through this doc.
      </span>
    </div>
    {controls.map(({ key, label, icon }) => (
      <div class="doc-control" data-tooltip>
        {key === 'markdown' ? (
          <a
            class="doc-action"
            href={`${doc.url}.md`}
            aria-label={label}
            aria-describedby={`${doc.id}-${key}-tip`}
          >
            <Icon name={icon} />
          </a>
        ) : (
          <button
            type="button"
            class="doc-action"
            aria-label={label}
            aria-describedby={`${doc.id}-${key}-tip`}
            data-ask-koi={key === 'ask' ? '' : undefined}
            data-copy-markdown={key === 'copy' ? `${doc.url}.md` : undefined}
            data-more-doc={key === 'more' ? '' : undefined}
            aria-expanded={
              key === 'ask' || key === 'more' ? 'false' : undefined
            }
            aria-controls={
              key === 'ask'
                ? 'ask-koi'
                : key === 'more'
                  ? `${doc.id}-menu`
                  : undefined
            }
            aria-haspopup={key === 'more' ? 'menu' : undefined}
          >
            {key === 'copy' ? (
              <Fragment set:html={copyIcon} />
            ) : (
              <Icon name={icon} />
            )}
          </button>
        )}
        <span class="doc-tooltip" role="tooltip" id={`${doc.id}-${key}-tip`}>
          {label}
        </span>
        {key === 'more' && (
          <div
            class="doc-action-menu"
            id={`${doc.id}-menu`}
            role="menu"
            aria-label="More doc actions"
            hidden
          >
            <a role="menuitem" tabindex="-1" href="/agents">
              <Icon name="agent" />
              See agent guidance
            </a>
            <a
              role="menuitem"
              tabindex="-1"
              href={links.chatgpt}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="openai" />
              Ask ChatGPT
            </a>
            <a
              role="menuitem"
              tabindex="-1"
              href={links.claude}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="claude" />
              Ask Claude
            </a>
            <a
              role="menuitem"
              tabindex="-1"
              href={links.issue}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="warning" />
              Report an issue
            </a>
          </div>
        )}
      </div>
    ))}
  </div>
</div>
