---
import CtaArrow from './CtaArrow.astro';
interface Props {
  html: string;
  nextAtBottom?: boolean;
}
const { html, nextAtBottom = false } = Astro.props;
const quickEnd = html.indexOf('<h2 id="doc-install-dependencies"');
---

<Fragment set:html={html.slice(0, quickEnd)} />
<div class="install-next">
  <a class="button" href="/docs/quickstart">
    Next: Quickstart <CtaArrow />
  </a>
</div>
<Fragment set:html={html.slice(quickEnd)} />
{nextAtBottom && (
  <div class="install-next">
    <a class="button" href="/docs/quickstart">
      Next: Quickstart <CtaArrow />
    </a>
  </div>
)}
