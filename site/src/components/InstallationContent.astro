---
import { docsUrl } from '../lib/documentation';
import type { KoiVersion } from '../lib/versions';
import CtaArrow from './CtaArrow.astro';
interface Props {
  html: string;
  version?: KoiVersion;
  nextAtBottom?: boolean;
}
const { html, nextAtBottom = false, version } = Astro.props;
const nextSections = new Set([
  'doc-install-quick-install',
  'doc-install-homebrew-and-mise',
  'doc-install-manual-install',
  'doc-install-github-download',
  'doc-install-clone',
]);
const sections = html.split(/(?=<h2\b)/).map((section) => ({
  html: section,
  next: nextSections.has(section.match(/^<h2 id="([^"]+)"/)?.[1] || ''),
}));
if (nextAtBottom) sections.push({ html: '', next: true });
const quickstartUrl = await docsUrl('quickstart', version);
---

{sections.map((section) => (
  <Fragment>
    <Fragment set:html={section.html} />
    {section.next && (
      <div class="install-next">
        <a class="button" href={quickstartUrl}>
          Next: Quickstart <CtaArrow />
        </a>
      </div>
    )}
  </Fragment>
))}
