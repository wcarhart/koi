---
import '../styles/global.css';
import { versionForPath, getVersions, type KoiVersion } from '../lib/versions';
import { getDocs } from '../lib/content';
import { pageMetadata } from '../lib/page-metadata';
import { apiReferences } from '../lib/api-references';
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  class?: string;
  documentationVersion?: KoiVersion;
}
const {
  title,
  description,
  noindex = false,
  class: className = '',
  documentationVersion,
} = Astro.props;
const version = documentationVersion ?? versionForPath(Astro.url.pathname);
const docs = await getDocs(version);
const references = apiReferences(docs);
const metadata = pageMetadata(Astro.url.pathname, docs);
const unreleasedNoindex =
  version.id === 'unreleased' &&
  getVersions().length > 1 &&
  /^\/docs(?:\/|$)/.test(Astro.url.pathname);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · koi</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={metadata.canonical} />
    {metadata.markdownUrl && (
      <link rel="alternate" type="text/markdown" href={metadata.markdownUrl} />
    )}
    {metadata.describedBy && (
      <link rel="describedby" href={metadata.describedBy} />
    )}
    <meta property="og:title" content={`${title} · koi`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {(noindex || metadata.noindex || unreleasedNoindex) && (
      <meta name="robots" content="noindex" />
    )}
    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        if (
          location.pathname === '/docs' ||
          location.pathname.startsWith('/docs/')
        )
          document.documentElement.classList.add('docs-initializing');
        let theme;
        try {
          theme = localStorage.getItem('koi-theme');
        } catch {}
        document.documentElement.dataset.theme =
          theme === 'light' || theme === 'dark'
            ? theme
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
      })();
    </script>
  </head>
  <body class={className}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot />
    <script
      id="api-references"
      type="application/json"
      set:html={JSON.stringify(references).replaceAll('<', '\\u003c')}
    />
    <div
      id="announcement"
      class="sr-only"
      role="status"
      aria-live="polite"
    ></div>
    <script>
      import '../scripts/global';
      import '../scripts/install-tabs';
      import '../scripts/api-tooltips';
    </script>
  </body>
</html>
