---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Page not found"
  description="This koi page could not be found."
  noindex
>
  <Header />
  <main id="main" class="error-page">
    <span class="eyebrow">EXIT STATUS / 404</span>
    <h1>Command not found.</h1>
    <p>
      This page isn't here. Head back to the documentation to find your way.
    </p>
    <a class="button primary" href="/docs">
      Open the docs →
    </a>
  </main>
  <Footer />
</Base>
