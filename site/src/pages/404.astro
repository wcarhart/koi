---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TerminalCommand from '../components/TerminalCommand.astro';
import CtaArrow from '../components/CtaArrow.astro';
---

<Base
  title="Page not found"
  description="This koi page could not be found."
  noindex
>
  <Header />
  <main id="main" class="error-page">
    <h1>Not found</h1>
    <div class="terminal-session error-shell">
      <TerminalCommand>echo $?</TerminalCommand>
      <div>404</div>
    </div>
    <p>
      There's nothing here. The link may be out of date, or the page may have
      moved.
    </p>
    <div class="button-row">
      <a class="button" href="/">
        <span class="error-back-arrow">
          <CtaArrow />
        </span>{' '}
        Back home
      </a>
      <a class="button" href="/docs">
        Read the docs <CtaArrow />
      </a>
    </div>
  </main>
  <Footer />
</Base>
