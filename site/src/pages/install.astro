---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InstallationContent from '../components/InstallationContent.astro';
import { getStandaloneInstallation } from '../lib/documentation';
import { getDefaultVersion } from '../lib/versions';
const version = getDefaultVersion();
const doc = await getStandaloneInstallation();
---

<Base
  documentationVersion={version}
  title={doc.title}
  description={doc.description}
  class="install-page"
>
  <Header />
  <main id="main" class="standalone prose">
    <h1>{doc.title}</h1>
    <p class="doc-description">{doc.description}</p>
    <InstallationContent html={doc.prose} version={version} nextAtBottom />
  </main>
  <Footer />
</Base>
