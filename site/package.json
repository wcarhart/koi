{
  "name": "@koi/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "tsx src/scripts/validate.ts && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:examples": "tsx src/scripts/verify-examples.ts"
  },
  "dependencies": {
    "astro": "7.4.11",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "marked": "18.2.0",
    "shiki": "4.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.10.0",
    "paper": "0.17.0",
    "prettier": "3.10.0",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
