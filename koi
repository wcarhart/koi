#!/usr/bin/env bash

# New to koi? Start here:
#   - https://github.com/wcarhart/koi
#   - https://koishell.com

# Namerefs target typed buffers, ShellCheck cannot infer their array types
# shellcheck disable=SC2004,SC2178

# ------------------ CONTROL FLOW ------------------

# Before Bash 5.3, POSIX mode cannot parse namespaced function definitions
if [ -n "${BASH_VERSION-}" ] && shopt -qo posix &&
    (( BASH_VERSINFO[0] < 5 || (BASH_VERSINFO[0] == 5 && BASH_VERSINFO[1] < 3) )); then
    printf '%s\n' 'koi: POSIX mode requires Bash >= 5.3' >&2
    return 2
fi

# prevent usage below Bash 5.2
__koi_bash_major_version=5
__koi_bash_minor_version=2
__koi_bash_version="${__koi_bash_major_version}.${__koi_bash_minor_version}"

if [ -z "${BASH_VERSION-}" ]; then
    printf 'koi: requires Bash >= %s\n' "$__koi_bash_version" >&2
    return 2
fi
if (( BASH_VERSINFO[0] < __koi_bash_major_version ||
      (BASH_VERSINFO[0] == __koi_bash_major_version && BASH_VERSINFO[1] < __koi_bash_minor_version) )); then
    printf 'koi: requires Bash >= %s\n' "$__koi_bash_version" >&2
    return 2
fi

# Re-sourcing preserves both unfinished registration and the root lifecycle
if [[ ${__koi_initialized-} != 1 ]]; then
    declare -ga __koi_spec_fields=(commands handlers descriptions args arg_shorts arg_longs arg_kinds arg_cardinalities arg_descriptions arg_requireds arg_defaults arg_display_names validator_dests validator_selectors validator_functions validator_messages group_types group_requireds group_offsets group_counts group_members arg_groups dependency_sources dependency_targets meta)
    declare -ga __koi_root_commands=()
    declare -gA __koi_root_handlers=()
    declare -gA __koi_root_descriptions=()
    declare -ga __koi_root_args=()
    declare -gA __koi_root_arg_shorts=()
    declare -gA __koi_root_arg_longs=()
    declare -gA __koi_root_arg_kinds=()
    declare -gA __koi_root_arg_cardinalities=()
    declare -gA __koi_root_arg_descriptions=()
    declare -gA __koi_root_arg_requireds=()
    declare -gA __koi_root_arg_defaults=()
    declare -gA __koi_root_arg_display_names=()
    declare -ga __koi_root_validator_dests=()
    declare -ga __koi_root_validator_selectors=()
    declare -ga __koi_root_validator_functions=()
    declare -ga __koi_root_validator_messages=()
    declare -ga __koi_root_group_types=()
    declare -ga __koi_root_group_requireds=()
    declare -ga __koi_root_group_offsets=()
    declare -ga __koi_root_group_counts=()
    declare -ga __koi_root_group_members=()
    declare -gA __koi_root_arg_groups=()
    declare -ga __koi_root_dependency_sources=()
    declare -ga __koi_root_dependency_targets=()
    declare -gA __koi_config=()
    declare -gA __koi_root_meta=()
    declare -gi __koi_root_spec_valid=1
    declare -ga __koi_pending_commands=()
    declare -gA __koi_pending_handlers=()
    declare -gA __koi_pending_descriptions=()
    declare -ga __koi_pending_args=()
    declare -gA __koi_pending_arg_shorts=()
    declare -gA __koi_pending_arg_longs=()
    declare -gA __koi_pending_arg_kinds=()
    declare -gA __koi_pending_arg_cardinalities=()
    declare -gA __koi_pending_arg_descriptions=()
    declare -gA __koi_pending_arg_requireds=()
    declare -gA __koi_pending_arg_defaults=()
    declare -gA __koi_pending_arg_display_names=()
    declare -ga __koi_pending_validator_dests=()
    declare -ga __koi_pending_validator_selectors=()
    declare -ga __koi_pending_validator_functions=()
    declare -ga __koi_pending_validator_messages=()
    declare -ga __koi_pending_group_types=()
    declare -ga __koi_pending_group_requireds=()
    declare -ga __koi_pending_group_offsets=()
    declare -ga __koi_pending_group_counts=()
    declare -ga __koi_pending_group_members=()
    declare -gA __koi_pending_arg_groups=()
    declare -ga __koi_pending_dependency_sources=()
    declare -ga __koi_pending_dependency_targets=()
    declare -gA __koi_pending_meta=()
    declare -gi __koi_pending_spec_valid=1
    declare -gi __koi_root_used=0
    declare -ga __koi_reserved_longs=(help)
    # shellcheck disable=SC2034
    declare -g koi_status=0
    __koi_initialized=1
fi

# ------------------ PUBLIC API ------------------

# Configure script-wide or function level policies. Function-level settings are
# consumed with the spec, repeated keys invalidate the block.
# Usage: koi::config KEY VALUE
#   KEY    name, help-width, help-subcommand, verbose-help, help-hints,
#          missing-command-message, help-on-unknown-commands (script only), or
#          description, epilog, use-single-pipe-for-or-groups, ignore-unknown-positionals,
#          error-on-scalar-duplicates (script or function)
#   VALUE  nonempty text, positive help-width (at most nine digits), or true/false
# Returns 2 on invalid arguments, scope, values, or repeated explicit settings
koi::config() {
    local __koi_buffer __koi_config_script_only=1 __koi_config_boolean=0
    koi::internal::select_registration_buffer __koi_buffer koi::config || return 2
    if (( $# != 2 )) || [[ -z $2 ]]; then
        koi::internal::spec_error "$__koi_buffer" koi::config 'KEY and nonempty VALUE required'
        return 2
    fi

    case $1 in
        name|missing-command-message)
            ;;
        description|epilog)
            __koi_config_script_only=0
            ;;
        help-width)
            if [[ ! $2 =~ ^[0-9]+$ || ${#2} -gt 9 ]] || (( 10#$2 == 0 )); then
                koi::internal::spec_error "$__koi_buffer" koi::config 'help-width must be a positive integer'
                return 2
            fi
            ;;
        help-subcommand|verbose-help|help-hints|help-on-unknown-commands)
            __koi_config_boolean=1
            ;;
        use-single-pipe-for-or-groups|ignore-unknown-positionals|error-on-scalar-duplicates)
            __koi_config_script_only=0
            __koi_config_boolean=1
            ;;
        *)
            koi::internal::spec_error "$__koi_buffer" koi::config "unknown key: $1"
            return 2
            ;;
    esac

    if (( __koi_config_script_only )) && [[ $__koi_buffer != __koi_root ]]; then
        koi::internal::spec_error "$__koi_buffer" koi::config "script-only config key: $1"
        return 2
    fi

    if (( __koi_config_boolean )) && [[ $2 != true && $2 != false ]]; then
        koi::internal::spec_error "$__koi_buffer" koi::config "$1 must be true or false"
        return 2
    fi

    local __koi_config_storage="${__koi_buffer}_meta"
    case $1 in
        name|help-width)
            __koi_config_storage=__koi_config
            ;;
        description)
            if [[ $__koi_buffer == __koi_root ]]; then
                __koi_config_storage=__koi_config
            fi
            ;;
    esac

    local -n __koi_config_values=$__koi_config_storage
    if [[ ${__koi_config_values[$1]+present} ]]; then
        koi::internal::spec_error "$__koi_buffer" koi::config "repeated config key: $1"
        return 2
    fi
    __koi_config_values[$1]=$2
}

# Register a command with koi. The command will be registered as an immediate
# child in the current uninterrupted registration block. In functions, you
# must close the registration block with koi::parse. In the root context,
# you must close the registration with koi::run.
# Usage: koi::add_command NAME -f HANDLER -d DESCRIPTION
#   NAME               the name of the command
#   -f, --function     the command's handler; ASCII letter/underscore first, then letters/digits/_/:
#   -d, --description  the description of the command
# Returns 2 on invalid declarations
koi::add_command() {
    local __koi_buffer
    koi::internal::select_registration_buffer __koi_buffer koi::add_command || return $?
    local -n __koi_commands="${__koi_buffer}_commands"
    local -n __koi_handlers="${__koi_buffer}_handlers"
    local -n __koi_descriptions="${__koi_buffer}_descriptions"

    local __koi_name=${1-} __koi_handler='' __koi_description=''
    local __koi_seen_function=0 __koi_seen_description=0

    if (( $# == 0 )); then
        koi::internal::spec_error "$__koi_buffer" koi::add_command 'command name required'
        return 2
    fi
    shift

    if [[ ! $__koi_name =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]]; then
        koi::internal::spec_error "$__koi_buffer" koi::add_command "invalid command name: '$__koi_name'"
        return 2
    fi

    while (( $# )); do
        case $1 in
            -f|--function)
                if (( __koi_seen_function || $# < 2 )); then
                    koi::internal::spec_error "$__koi_buffer" koi::add_command 'invalid --function'
                    return 2
                fi
                __koi_seen_function=1
                __koi_handler=$2
                ;;
            -d|--description)
                if (( __koi_seen_description || $# < 2 )); then
                    koi::internal::spec_error "$__koi_buffer" koi::add_command 'invalid --description'
                    return 2
                fi
                __koi_seen_description=1
                __koi_description=$2
                ;;
            *)
                koi::internal::spec_error "$__koi_buffer" koi::add_command "unknown registration parameter: $1"
                return 2
                ;;
        esac
        shift 2
    done

    if [[ ! $__koi_handler =~ ^[a-zA-Z_][a-zA-Z0-9_:]*$ ]]; then
        koi::internal::spec_error "$__koi_buffer" koi::add_command 'handler identifier required'
        return 2
    fi

    if [[ -z $__koi_description ]]; then
        koi::internal::spec_error "$__koi_buffer" koi::add_command 'nonempty description required'
        return 2
    fi

    if [[ ${__koi_handlers[$__koi_name]+present} ]]; then
        koi::internal::spec_error "$__koi_buffer" koi::add_command "duplicate command: $__koi_name"
        return 2
    fi

    __koi_commands+=("$__koi_name")
    __koi_handlers[$__koi_name]=$__koi_handler
    __koi_descriptions[$__koi_name]=$__koi_description
}

# Register a parsable argument with koi. The argument will be registered with the
# current uninterrupted registration block. In functions, you must close the
# registration block with koi::parse. In the root context, you must close the
# registration with koi::run( koi::parse is only supported inside functions).
# Usage: koi::add_arg DEST (-f|-o|-p) -d DESCRIPTION [-s SHORT || -l LONG] [-S|-a] [-r] [-D DEFAULT] [-n DISPLAY_NAME]
# Flags/options require a short or long spelling; positionals reject both.
#   DEST                     the Bash destination variable name
#   -f, --flag               register a boolean flag (e.g. '-f')
#   -o, --option             register an option that consumes one value (e.g. '-o value')
#   -p, --positional         consume positional values in declaration order
#   -S, --scalar             store one value (options and positionals only, default behavior)
#   -a, --array              store an indexed array (options and positionals only)
#   -s, --short              short spelling without its dash (one letter)
#   -l, --long               long spelling without its dashes
#   -d, --description        nonempty argument description
#   -r, --required           require explicit presence when parsing
#   -D, --default DEFAULT    default for an optional option or positional (empty allowed)
#   -n, --display-name NAME  option or positional value label
# Returns 2 on invalid declarations
koi::add_arg() {
    local __koi_buffer
    koi::internal::select_registration_buffer __koi_buffer koi::add_arg || return $?
    local -n __koi_args="${__koi_buffer}_args"
    local -n __koi_arg_shorts="${__koi_buffer}_arg_shorts"
    local -n __koi_arg_longs="${__koi_buffer}_arg_longs"
    local -n __koi_arg_kinds="${__koi_buffer}_arg_kinds"
    local -n __koi_arg_cardinalities="${__koi_buffer}_arg_cardinalities"
    local -n __koi_arg_descriptions="${__koi_buffer}_arg_descriptions"
    local -n __koi_arg_requireds="${__koi_buffer}_arg_requireds"
    local -n __koi_arg_defaults="${__koi_buffer}_arg_defaults"
    local -n __koi_arg_display_names="${__koi_buffer}_arg_display_names"

    local __koi_dest=${1-} __koi_parameter __koi_value
    local -A __koi_values=([short]='' [long]='' [kind]='' [cardinality]=scalar [description]='' [required]=0)
    local -A __koi_seen=()

    if (( $# == 0 )); then
        koi::internal::spec_error "$__koi_buffer" koi::add_arg 'destination required'
        return 2
    fi
    shift

    koi::internal::validate_arg_destination "$__koi_buffer" "$__koi_dest" || return $?

    while (( $# )); do
        case $1 in
            -f|--flag)
                __koi_parameter=kind
                __koi_value=flag
                ;;
            -o|--option)
                __koi_parameter=kind
                __koi_value=option
                ;;
            -p|--positional)
                __koi_parameter=kind
                __koi_value=positional
                ;;
            -S|--scalar)
                __koi_parameter=cardinality
                __koi_value=scalar
                ;;
            -a|--array)
                __koi_parameter=cardinality
                __koi_value=array
                ;;
            -r|--required)
                __koi_parameter=required
                __koi_value=1
                ;;
            -s|--short)
                __koi_parameter=short
                ;;
            -l|--long)
                __koi_parameter=long
                ;;
            -d|--description)
                __koi_parameter=description
                ;;
            -D|--default)
                __koi_parameter=default
                ;;
            -n|--display-name)
                __koi_parameter=display_name
                ;;
            *)
                koi::internal::spec_error "$__koi_buffer" koi::add_arg "unknown declaration parameter: $1"
                return 2
                ;;
        esac

        if [[ ${__koi_seen[$__koi_parameter]+present} ]]; then
            koi::internal::spec_error "$__koi_buffer" koi::add_arg "repeated or conflicting parameter: $__koi_parameter"
            return 2
        fi

        case $__koi_parameter in
            kind|required|cardinality)
                shift
                ;;
            *)
                if (( $# < 2 )); then
                    koi::internal::spec_error "$__koi_buffer" koi::add_arg "missing value for $1"
                    return 2
                fi
                __koi_value=$2
                shift 2
                ;;
        esac

        __koi_seen[$__koi_parameter]=1
        __koi_values[$__koi_parameter]=$__koi_value
    done

    koi::internal::validate_arg_spec "$__koi_buffer" "$__koi_dest" __koi_values __koi_seen || return $?

    __koi_args+=("$__koi_dest")
    __koi_arg_shorts[$__koi_dest]=${__koi_values[short]}
    __koi_arg_longs[$__koi_dest]=${__koi_values[long]}
    __koi_arg_kinds[$__koi_dest]=${__koi_values[kind]}
    __koi_arg_cardinalities[$__koi_dest]=${__koi_values[cardinality]}
    __koi_arg_descriptions[$__koi_dest]=${__koi_values[description]}
    __koi_arg_requireds[$__koi_dest]=${__koi_values[required]}
    if [[ ${__koi_seen[display_name]+present} ]]; then
        __koi_arg_display_names[$__koi_dest]=${__koi_values[display_name]}
    fi
    if [[ ${__koi_seen[default]+present} ]]; then
        __koi_arg_defaults[$__koi_dest]=${__koi_values[default]}
    fi
    return 0
}

# Register a value predicate (aka a "validator") for an already-declared
# option or positional (flags cannot be validated)
# Usage: koi::add_validator DEST (--nonempty|--integer|--file|--directory)
# Usage: koi::add_validator DEST -f FUNCTION [-m MESSAGE]
#   DEST             destination in the current registration block; flags are rejected
#   --nonempty       require at least one character, including whitespace
#   --integer        require signed or unsigned ASCII decimal digits
#   --file           require an existing regular file (Bash -f)
#   --directory      require an existing directory (Bash -d)
#   -f, --function   Bash predicate called with exactly one literal value
#   -m, --message    nonempty rejection reason for a custom predicate
# Returns 0 silently or 2 on author error
koi::add_validator() {
    local __koi_buffer
    koi::internal::select_registration_buffer __koi_buffer koi::add_validator || return 2
    local __koi_validator_dest=${1-} __koi_validator_selector='' __koi_validator_function='' __koi_validator_message=''
    local __koi_validator_seen_message=0 __koi_validator_error=''
    local -n __koi_validator_kinds="${__koi_buffer}_arg_kinds"
    local -n __koi_validator_dests="${__koi_buffer}_validator_dests"
    local -n __koi_validator_selectors="${__koi_buffer}_validator_selectors"
    local -n __koi_validator_functions="${__koi_buffer}_validator_functions"
    local -n __koi_validator_messages="${__koi_buffer}_validator_messages"

    if [[ ! $__koi_validator_dest =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]]; then
        __koi_validator_error='registered option or positional destination required'
    elif [[ ${__koi_validator_kinds[$__koi_validator_dest]-} != option && ${__koi_validator_kinds[$__koi_validator_dest]-} != positional ]]; then
        __koi_validator_error="not an option or positional in this context: '$__koi_validator_dest'"
    fi

    if (( $# )); then
        shift
    fi

    while (( $# )) && [[ -z $__koi_validator_error ]]; do
        case $1 in
            --nonempty|--integer|--file|--directory|-f|--function)
                if [[ -n $__koi_validator_selector ]]; then
                    __koi_validator_error='exactly one validator selector required'
                    break
                fi

                __koi_validator_selector=${1#--}
                if [[ $1 == -f || $1 == --function ]]; then
                    if (( $# < 2 )) || [[ ! $2 =~ ^[a-zA-Z_][a-zA-Z0-9_:]*$ ]]; then
                        __koi_validator_error='valid function identifier required'
                        break
                    fi

                    __koi_validator_selector=custom
                    __koi_validator_function=$2
                    shift
                fi
                ;;
            -m|--message)
                if (( __koi_validator_seen_message || $# < 2 )) || [[ -z $2 ]]; then
                    __koi_validator_error='one nonempty message required'
                    break
                fi

                __koi_validator_seen_message=1
                __koi_validator_message=$2
                shift
                ;;
            *)
                __koi_validator_error="unknown declaration parameter: $1"
                ;;
        esac
        shift
    done

    if [[ -z $__koi_validator_selector ]]; then
        __koi_validator_error='exactly one validator selector required'
    elif (( __koi_validator_seen_message )) && [[ $__koi_validator_selector != custom ]]; then
        __koi_validator_error='messages require a custom function'
    fi

    if [[ -n $__koi_validator_error ]]; then
        koi::internal::spec_error "$__koi_buffer" koi::add_validator "$__koi_validator_error"
        return 2
    fi

    __koi_validator_dests+=("$__koi_validator_dest")
    __koi_validator_selectors+=("$__koi_validator_selector")
    __koi_validator_functions+=("$__koi_validator_function")
    __koi_validator_messages+=("$__koi_validator_message")
    return 0
}

# Register a flat group of previously declared optional flags and options
# Usage: koi::add_group (-x|-o|-a) [-r] DEST DEST...
#   -x, --xor       allow zero or one member, or exactly one when required
#   -o, --or        require one or more members, must include --required
#   -a, --and       allow zero or all members, or require all when required
#   -r, --required  require the group instead of allowing no members
#   DEST...         at least two distinct destinations in this context
# Returns 2 and invalidates registration on an invalid declaration
koi::add_group() {
    local __koi_buffer
    koi::internal::select_registration_buffer __koi_buffer koi::add_group || return 2
    local -n __koi_group_types="${__koi_buffer}_group_types"
    local -n __koi_group_requireds="${__koi_buffer}_group_requireds"
    local -n __koi_group_offsets="${__koi_buffer}_group_offsets"
    local -n __koi_group_counts="${__koi_buffer}_group_counts"
    local -n __koi_group_members="${__koi_buffer}_group_members"
    local -n __koi_arg_groups="${__koi_buffer}_arg_groups"
    local -n __koi_group_arg_requireds="${__koi_buffer}_arg_requireds"
    local __koi_group_type='' __koi_group_required=0 __koi_group_dest
    local -A __koi_group_seen=()

    while (( $# )) && [[ $1 == -* ]]; do
        case $1 in
            -x|--xor|-o|--or|-a|--and)
                if [[ -n $__koi_group_type ]]; then
                    koi::internal::spec_error "$__koi_buffer" koi::add_group 'exactly one group type required'
                    return 2
                fi
                case $1 in
                    -x|--xor)
                        __koi_group_type=xor
                        ;;
                    -o|--or)
                        __koi_group_type=or
                        ;;
                    -a|--and)
                        __koi_group_type=and
                        ;;
                esac
                ;;
            -r|--required)
                if (( __koi_group_required )); then
                    koi::internal::spec_error "$__koi_buffer" koi::add_group 'repeated --required'
                    return 2
                fi
                __koi_group_required=1
                ;;
            *)
                koi::internal::spec_error "$__koi_buffer" koi::add_group "unknown declaration parameter: $1"
                return 2
                ;;
        esac
        shift
    done

    if [[ -z $__koi_group_type ]] || (( $# < 2 )); then
        koi::internal::spec_error "$__koi_buffer" koi::add_group 'one group type and at least two destinations required'
        return 2
    fi

    if [[ $__koi_group_type == or ]] && (( ! __koi_group_required )); then
        koi::internal::spec_error "$__koi_buffer" koi::add_group '--or requires --required'
        return 2
    fi

    for __koi_group_dest in "$@"; do
        koi::internal::check_relationship_arg "$__koi_buffer" koi::add_group "$__koi_group_dest" || return 2
        if [[ ${__koi_group_seen[$__koi_group_dest]+present} || ${__koi_arg_groups[$__koi_group_dest]+present} ]]; then
            koi::internal::spec_error "$__koi_buffer" koi::add_group "duplicate or already grouped argument: '$__koi_group_dest'"
            return 2
        fi

        if [[ ${__koi_group_arg_requireds[$__koi_group_dest]} == 1 ]]; then
            koi::internal::spec_error "$__koi_buffer" koi::add_group "group member cannot be individually required: '$__koi_group_dest'"
            return 2
        fi
        __koi_group_seen[$__koi_group_dest]=1
    done

    local __koi_group_index=${#__koi_group_types[@]}
    __koi_group_types+=("$__koi_group_type")
    __koi_group_requireds+=("$__koi_group_required")
    __koi_group_offsets+=("${#__koi_group_members[@]}")
    __koi_group_counts+=("$#")
    for __koi_group_dest in "$@"; do
        __koi_arg_groups[$__koi_group_dest]=$__koi_group_index
        __koi_group_members+=("$__koi_group_dest")
    done

    return 0
}

# Require explicit prerequisites whenever a previously declared argument is supplied
# Usage: koi::add_dependency DEST (-r) DEST...
#   DEST             one dependent flag or option in this context
#   -r, --requires   separate the dependent from its prerequisites
#   DEST...          one or more distinct prerequisite flags or options
# Returns 2 and invalidates registration on an invalid declaration
koi::add_dependency() {
    local __koi_buffer
    koi::internal::select_registration_buffer __koi_buffer koi::add_dependency || return 2
    if (( $# < 3 )) || [[ $2 != -r && $2 != --requires ]]; then
        koi::internal::spec_error "$__koi_buffer" koi::add_dependency 'expected DEST --requires DEST...'
        return 2
    fi

    local __koi_dependency_source=$1 __koi_dependency_target __koi_dependency_index
    koi::internal::check_relationship_arg "$__koi_buffer" koi::add_dependency "$__koi_dependency_source" || return 2
    shift 2
    local -n __koi_dependency_sources="${__koi_buffer}_dependency_sources"
    local -n __koi_dependency_targets="${__koi_buffer}_dependency_targets"
    local -A __koi_dependency_seen=()
    for __koi_dependency_target in "$@"; do
        koi::internal::check_relationship_arg "$__koi_buffer" koi::add_dependency "$__koi_dependency_target" || return 2
        if [[ $__koi_dependency_source == "$__koi_dependency_target" ]]; then
            koi::internal::spec_error "$__koi_buffer" koi::add_dependency 'an argument cannot depend on itself'
            return 2
        fi

        if [[ ${__koi_dependency_seen[$__koi_dependency_target]+present} ]]; then
            koi::internal::spec_error "$__koi_buffer" koi::add_dependency "duplicate dependency: '$__koi_dependency_source' requires '$__koi_dependency_target'"
            return 2
        fi

        for __koi_dependency_index in "${!__koi_dependency_sources[@]}"; do
            if [[ ${__koi_dependency_sources[$__koi_dependency_index]} == "$__koi_dependency_source" &&
                  ${__koi_dependency_targets[$__koi_dependency_index]} == "$__koi_dependency_target" ]]; then
                koi::internal::spec_error "$__koi_buffer" koi::add_dependency "duplicate dependency: '$__koi_dependency_source' requires '$__koi_dependency_target'"
                return 2
            fi
        done
        __koi_dependency_seen[$__koi_dependency_target]=1
    done

    for __koi_dependency_target in "$@"; do
        __koi_dependency_sources+=("$__koi_dependency_source")
        __koi_dependency_targets+=("$__koi_dependency_target")
    done

    return 0
}

# Consume argument registration and parse arguments, assign literal scalar/array
# values, and optionally route a child command. Closes the current
# uninterrupted registration block. $koi_status is the owning function's
# return status and is used for exit/return control flow. Only supported from
# inside application functions, not top-level/root context (use koi::run
# in that scenario).
# Usage: koi::parse "$@" || return "$koi_status"
#   $@  application arguments to parse
# Returns 0 to continue, 1 to stop after help/dispatch, or 2 on error
koi::parse() {
    local __koi_buffer __koi_path='' __koi_result __koi_collect_matches=0
    koi_status=2
    koi::internal::select_registration_buffer __koi_buffer koi::parse || return 2
    if [[ $__koi_buffer == __koi_root ]]; then
        koi::internal::author_error koi::parse 'must be called inside a function, use koi::run at top level'
        return 2
    fi
    local -a __koi_parsed_commands=()
    local -A __koi_parsed_handlers=()
    local -A __koi_parsed_descriptions=()
    local -a __koi_parsed_args=()
    local -A __koi_parsed_arg_shorts=()
    local -A __koi_parsed_arg_longs=()
    local -A __koi_parsed_arg_kinds=()
    local -A __koi_parsed_arg_cardinalities=()
    local -A __koi_parsed_arg_descriptions=()
    local -A __koi_parsed_arg_requireds=()
    local -A __koi_parsed_arg_defaults=()
    local -A __koi_parsed_arg_display_names=()
    local -a __koi_parsed_validator_dests=()
    local -a __koi_parsed_validator_selectors=()
    local -a __koi_parsed_validator_functions=()
    local -a __koi_parsed_validator_messages=()
    local -a __koi_parsed_group_types=()
    local -a __koi_parsed_group_requireds=()
    local -a __koi_parsed_group_offsets=()
    local -a __koi_parsed_group_counts=()
    local -a __koi_parsed_group_members=()
    local -A __koi_parsed_arg_groups=()
    local -a __koi_parsed_dependency_sources=()
    local -a __koi_parsed_dependency_targets=()
    local -A __koi_parsed_meta=()
    local -i __koi_parsed_spec_valid=1

    # move registration into parser-local storage before validation or nested dispatch
    koi::internal::take_spec "$__koi_buffer" __koi_parsed
    # attach script settings and default help metadata to the function spec
    koi::internal::prepare_spec __koi_parsed 0
    # match the requested invocation so helpers and recursion cannot capture its collector
    if [[ ${FUNCNAME[1]-} == "${__koi_inspection_handler-}" &&
          ${#FUNCNAME[@]} == "${__koi_inspection_depth-}" ]]; then
        __koi_collect_matches=1
    fi

    # apply the CLI path only to the handler invocation selected by routing
    if [[ ${FUNCNAME[1]-} == "${__koi_route_handler-}" &&
          ${#FUNCNAME[@]} == "${__koi_route_depth-}" ]]; then
        __koi_path=${__koi_route_path-}
        __koi_parsed_meta[description]=${__koi_route_description-}
        __koi_parsed_meta[builtin]=${__koi_route_help:-0}
        __koi_parsed_meta[verbose]=${__koi_route_verbose:-0}
        if [[ ! ${__koi_parsed_meta[use-single-pipe-for-or-groups]+present} ]]; then
            __koi_parsed_meta[single-pipe]=${__koi_route_single_pipe:-0}
        fi
    fi

    __koi_parsed_meta[path]=$__koi_path

    # parse the consumed spec and capture any selected child command
    local __koi_selected_handler='' __koi_selected_command=''
    local -a __koi_remaining=()
    if koi::internal::parse_spec __koi_parsed 0 "$__koi_path" '' 0 \
        __koi_selected_handler __koi_selected_command __koi_remaining "$@"; then
        __koi_result=0
    else
        __koi_result=$?
    fi

    # retain the child's description and help policy before discarding the spec
    local __koi_selected_description=''
    if [[ -n $__koi_selected_command ]]; then
        __koi_selected_description=${__koi_parsed_descriptions[$__koi_selected_command]-}
    fi
    local __koi_selected_help=${__koi_parsed_meta[builtin]}
    local __koi_selected_verbose=${__koi_parsed_meta[verbose]}
    local __koi_selected_single_pipe=${__koi_parsed_meta[single-pipe]}

    # release declaration metadata before invoking the selected child
    koi::internal::clear_spec __koi_parsed
    if (( __koi_result == 3 )); then
        local __koi_route_description=$__koi_selected_description
        local __koi_route_help=$__koi_selected_help __koi_route_verbose=$__koi_selected_verbose
        local __koi_route_single_pipe=$__koi_selected_single_pipe
        local __koi_route_handler=$__koi_selected_handler
        local __koi_route_depth=$((${#FUNCNAME[@]} + 2))
        local __koi_route_path=${__koi_path:+$__koi_path }$__koi_selected_command
        if "$__koi_selected_handler" "${__koi_remaining[@]}"; then
            __koi_result=0
        else
            __koi_result=$?
        fi
        koi_status=$__koi_result
        return 1
    fi

    # publish success for help while keeping the caller's return guard active
    # shellcheck disable=SC2034
    if (( __koi_result == 1 )); then
        koi_status=0
    else
        koi_status=$__koi_result
    fi

    return "$__koi_result"
}

# Consume root registration and route once per library initialization.
# Expected to be called once per script, repeated calls will error.
# Usage: koi::run "$@"
#   $@  root application options, positionals, or command and child arguments
# Returns the handler's status, 0 for help/terminal parsing, or 2 on error
koi::run() {
    if (( __koi_root_used )); then
        koi::internal::author_error koi::run 'call only once per script, koi::run has already been called'
        return 2
    fi
    __koi_root_used=1
    local -a __koi_parsed_commands=()
    local -A __koi_parsed_handlers=()
    local -A __koi_parsed_descriptions=()
    local -a __koi_parsed_args=()
    local -A __koi_parsed_arg_shorts=()
    local -A __koi_parsed_arg_longs=()
    local -A __koi_parsed_arg_kinds=()
    local -A __koi_parsed_arg_cardinalities=()
    local -A __koi_parsed_arg_descriptions=()
    local -A __koi_parsed_arg_requireds=()
    local -A __koi_parsed_arg_defaults=()
    local -A __koi_parsed_arg_display_names=()
    local -a __koi_parsed_validator_dests=()
    local -a __koi_parsed_validator_selectors=()
    local -a __koi_parsed_validator_functions=()
    local -a __koi_parsed_validator_messages=()
    local -a __koi_parsed_group_types=()
    local -a __koi_parsed_group_requireds=()
    local -a __koi_parsed_group_offsets=()
    local -a __koi_parsed_group_counts=()
    local -a __koi_parsed_group_members=()
    local -A __koi_parsed_arg_groups=()
    local -a __koi_parsed_dependency_sources=()
    local -a __koi_parsed_dependency_targets=()
    local -A __koi_parsed_meta=()
    local -i __koi_parsed_spec_valid=1
    koi::internal::take_spec __koi_root __koi_parsed
    if (( ! __koi_parsed_spec_valid )); then
        return 2
    fi
    local __koi_collect_matches=0
    # accept a root collector only at the runner invocation it explicitly targets
    if [[ ${__koi_inspection_handler-} == koi::run &&
          ${#FUNCNAME[@]} == "${__koi_inspection_depth-}" ]]; then
        __koi_collect_matches=1
    fi
    koi::internal::prepare_spec __koi_parsed 1
    local __koi_run_message=${__koi_parsed_meta[missing-command-message]-}
    local __koi_run_unknown_help=0
    if [[ ${__koi_parsed_meta[help-on-unknown-commands]-false} == true ]]; then
        __koi_run_unknown_help=1
    fi
    local __koi_run_help=${__koi_parsed_meta[builtin]}
    local __koi_run_verbose=${__koi_parsed_meta[verbose]}
    local __koi_result __koi_selected_handler='' __koi_selected_command=''
    local -a __koi_remaining=()

    # parse root options and prepare command dispatch
    if koi::internal::parse_spec __koi_parsed 1 '' "$__koi_run_message" "$__koi_run_unknown_help" \
        __koi_selected_handler __koi_selected_command __koi_remaining "$@"; then
        __koi_result=0
    else
        __koi_result=$?
    fi

    # retain the selected command's description before discarding root metadata
    local __koi_selected_description=''
    if [[ -n $__koi_selected_command ]]; then
        __koi_selected_description=${__koi_parsed_descriptions[$__koi_selected_command]-}
    fi

    local __koi_selected_single_pipe=${__koi_parsed_meta[single-pipe]}
    # discard root metadata and translate help into a successful runner return
    koi::internal::clear_spec __koi_parsed
    if (( __koi_result != 3 )); then
        if (( __koi_result == 1 )); then
            return 0
        fi
        return "$__koi_result"
    fi

    local __koi_route_description=$__koi_selected_description
    local __koi_route_help=$__koi_run_help __koi_route_verbose=$__koi_run_verbose
    local __koi_route_single_pipe=$__koi_selected_single_pipe
    local __koi_route_handler=$__koi_selected_handler
    local __koi_route_depth=$((${#FUNCNAME[@]} + 2))
    local __koi_route_path=$__koi_selected_command
    # leave dispatch unconditional so root handlers keep normal errexit behavior
    "$__koi_selected_handler" "${__koi_remaining[@]}"
}

# ------------------ INTERNAL ------------------

# Complete consumed metadata with script settings and direct-call defaults
# Usage: koi::internal::prepare_spec PREFIX ROOT
#   PREFIX  consumed spec prefix
#   ROOT    1 for script-scope registration, otherwise 0
# ShellCheck cannot infer associative keys through this nameref
# shellcheck disable=SC2154
koi::internal::prepare_spec() {
    local -n __koi_prepare_meta="${1}_meta"
    __koi_prepare_meta[name]=${__koi_config[name]:-${0##*/}}
    __koi_prepare_meta[help-width]=${__koi_config[help-width]:-100}
    __koi_prepare_meta[root]=$2
    __koi_prepare_meta[path]=''
    __koi_prepare_meta[builtin]=0
    __koi_prepare_meta[verbose]=0
    __koi_prepare_meta[hints]=0
    __koi_prepare_meta[runner]=0
    __koi_prepare_meta[single-pipe]=0

    if [[ ${__koi_prepare_meta[use-single-pipe-for-or-groups]-false} == true ]]; then
        __koi_prepare_meta[single-pipe]=1
    fi

    if (( $2 )); then
        __koi_prepare_meta[description]=${__koi_config[description]-}
        __koi_prepare_meta[runner]=1

        if [[ ${__koi_prepare_meta[help-subcommand]-true} == true ]]; then
            __koi_prepare_meta[builtin]=1
        fi

        if [[ ${__koi_prepare_meta[verbose-help]-false} == true ]]; then
            __koi_prepare_meta[verbose]=1
        fi

        if [[ ${__koi_prepare_meta[help-hints]-false} == true ]]; then
            __koi_prepare_meta[hints]=1
        fi
    fi
}

# Wrap description text, preserving explicit line breaks and unbroken words. Uses
# configured help-width, prints literal values without interpreting escapes.
# Usage: koi::internal::wrap TEXT FIRST_PREFIX CONTINUATION_PREFIX
#   TEXT                 description to print, split on spaces and tabs for wrapping
#   FIRST_PREFIX         prefix for the first output line
#   CONTINUATION_PREFIX  indentation for subsequent lines
koi::internal::wrap() {
    local __koi_wrap_text=$1 __koi_wrap_prefix=$2 __koi_wrap_indent=$3
    local __koi_wrap_line __koi_wrap_word __koi_wrap_output
    local __koi_wrap_width=${__koi_config[help-width]:-100}
    __koi_wrap_width=$((10#$__koi_wrap_width))
    local -a __koi_wrap_words=()
    while IFS= read -r __koi_wrap_line; do
        IFS=$' \t' read -r -a __koi_wrap_words <<< "$__koi_wrap_line"
        __koi_wrap_output=$__koi_wrap_prefix
        for __koi_wrap_word in "${__koi_wrap_words[@]}"; do
            if [[ $__koi_wrap_output != "$__koi_wrap_prefix" ]]; then
                if (( ${#__koi_wrap_output} + 1 + ${#__koi_wrap_word} > __koi_wrap_width )); then
                    printf '%s\n' "$__koi_wrap_output"
                    __koi_wrap_prefix=$__koi_wrap_indent
                    __koi_wrap_output=$__koi_wrap_prefix
                else
                    __koi_wrap_output+=' '
                fi
            fi
            __koi_wrap_output+=$__koi_wrap_word
        done
        printf '%s\n' "$__koi_wrap_output"
        __koi_wrap_prefix=$__koi_wrap_indent
    done <<< "$__koi_wrap_text"
}

# Render a collected context, then inspect its application children in order
# Usage: koi::internal::walk_spec PREFIX
#   PREFIX  consumed spec containing effective metadata and ordered children
# Returns 2 if a descendant cannot be inspected
koi::internal::walk_spec() {
    local __koi_tree_prefix=$1
    local -n __koi_tree_commands="${__koi_tree_prefix}_commands"
    local -n __koi_tree_handlers="${__koi_tree_prefix}_handlers"
    local -n __koi_tree_descriptions="${__koi_tree_prefix}_descriptions"
    local -n __koi_tree_meta="${__koi_tree_prefix}_meta"
    koi::internal::print_help "$__koi_tree_prefix" "${__koi_tree_meta[runner]}" "${__koi_tree_meta[path]}"
    local __koi_route_help=${__koi_tree_meta[builtin]} __koi_route_verbose=${__koi_tree_meta[verbose]}
    local __koi_route_single_pipe=${__koi_tree_meta[single-pipe]}
    local __koi_tree_child
    for __koi_tree_child in "${__koi_tree_commands[@]}"; do
        koi::internal::visit_command "${__koi_tree_handlers[$__koi_tree_child]}" \
            "${__koi_tree_meta[path]:+${__koi_tree_meta[path]} }$__koi_tree_child" \
            "${__koi_tree_descriptions[$__koi_tree_child]}" || return 2
    done
    return 0
}

# Inspect one routed handler into invocation-local arrays before descending
# Usage: koi::internal::visit_command HANDLER PATH DESCRIPTION
#   HANDLER      registered function to invoke once with an internal collector
#   PATH         complete CLI command path
#   DESCRIPTION  selected alias description
# Returns 2 on active-ancestry recursion, handler failure, or missing collection
koi::internal::visit_command() {
    local __koi_visit_handler=$1 __koi_visit_path=$2 __koi_visit_description=$3
    local __koi_visit_ancestor
    for __koi_visit_ancestor in "${__koi_walk_ancestors[@]}"; do
        if [[ $__koi_visit_ancestor == "$__koi_visit_handler" ]]; then
            koi::internal::author_error koi::run "recursive inspection at '$__koi_visit_path' (handler '$__koi_visit_handler')"
            return 2
        fi
    done
    local -a __koi_walk_ancestors=("${__koi_walk_ancestors[@]}" "$__koi_visit_handler")
    local -a __koi_visit_spec_commands=()
    local -A __koi_visit_spec_handlers=()
    local -A __koi_visit_spec_descriptions=()
    local -a __koi_visit_spec_args=()
    local -A __koi_visit_spec_arg_shorts=()
    local -A __koi_visit_spec_arg_longs=()
    local -A __koi_visit_spec_arg_kinds=()
    local -A __koi_visit_spec_arg_cardinalities=()
    local -A __koi_visit_spec_arg_descriptions=()
    local -A __koi_visit_spec_arg_requireds=()
    local -A __koi_visit_spec_arg_defaults=()
    local -A __koi_visit_spec_arg_display_names=()
    local -a __koi_visit_spec_validator_dests=()
    local -a __koi_visit_spec_validator_selectors=()
    local -a __koi_visit_spec_validator_functions=()
    local -a __koi_visit_spec_validator_messages=()
    local -a __koi_visit_spec_group_types=()
    local -a __koi_visit_spec_group_requireds=()
    local -a __koi_visit_spec_group_offsets=()
    local -a __koi_visit_spec_group_counts=()
    local -a __koi_visit_spec_group_members=()
    local -A __koi_visit_spec_arg_groups=()
    local -a __koi_visit_spec_dependency_sources=()
    local -a __koi_visit_spec_dependency_targets=()
    local -A __koi_visit_spec_meta=()
    local -i __koi_visit_spec_spec_valid=1
    local __koi_inspection_sink=__koi_visit_spec __koi_inspection_received=0
    local __koi_inspection_handler=$__koi_visit_handler
    local __koi_inspection_depth=$((${#FUNCNAME[@]} + 2))
    local __koi_route_handler=$__koi_visit_handler __koi_route_path=$__koi_visit_path
    local __koi_route_description=$__koi_visit_description
    local __koi_route_depth=$__koi_inspection_depth
    if "$__koi_visit_handler"; then
        if (( ! __koi_inspection_received )); then
            koi::internal::clear_spec __koi_pending
            koi::internal::author_error koi::run "inspection at '$__koi_visit_path' did not reach koi::parse"
            return 2
        fi
    else
        koi::internal::clear_spec __koi_pending
        koi::internal::author_error koi::run "inspection failed at '$__koi_visit_path'"
        return 2
    fi
    printf '\n'
    koi::internal::walk_spec __koi_visit_spec
}

# Select registration storage from the public API's application caller
# Usage: koi::internal::select_registration_buffer OUTPUT_VAR API
#   OUTPUT_VAR  receives the root or pending buffer prefix
#   API         public API requesting registration
# Returns 2 if root registration has already been consumed
koi::internal::select_registration_buffer() {
    local -n __koi_buffer_output=$1
    local __koi_frame
    __koi_buffer_output=__koi_root

    for ((__koi_frame=2; __koi_frame<${#FUNCNAME[@]}; __koi_frame++)); do
        case ${FUNCNAME[__koi_frame]} in
            source)
                continue
                ;;
            main)
                # Bash's script entry has no calling line, a function named main does
                if (( __koi_frame == ${#FUNCNAME[@]} - 1 && ${BASH_LINENO[__koi_frame]} == 0 )); then
                    continue
                fi
                ;;
        esac

        __koi_buffer_output=__koi_pending
        break
    done

    if [[ $__koi_buffer_output == __koi_root ]] && (( __koi_root_used )); then
        koi::internal::author_error "$2" 'root registration already consumed'
        return 2
    fi
    return 0
}

# Empty a spec and restore its registration validity
# Usage: koi::internal::clear_spec PREFIX
#   PREFIX  prefix of the spec's arrays and validity scalar
koi::internal::clear_spec() {
    local __koi_clear_field
    for __koi_clear_field in "${__koi_spec_fields[@]}"; do
        local -n __koi_clear_array="${1}_${__koi_clear_field}"
        __koi_clear_array=()
    done
    local -n __koi_clear_valid="${1}_spec_valid"
    __koi_clear_valid=1
}

# Copy a spec into already-declared typed storage without interpreting values
# Usage: koi::internal::copy_spec SOURCE_PREFIX TARGET_PREFIX
#   SOURCE_PREFIX  spec to read
#   TARGET_PREFIX  destination arrays and validity scalar; previous contents are cleared
koi::internal::copy_spec() {
    koi::internal::clear_spec "$2"
    local __koi_take_field __koi_take_key

    # copy fields by key to preserve array order and literal metadata values
    for __koi_take_field in "${__koi_spec_fields[@]}"; do
        local -n __koi_take_source="${1}_${__koi_take_field}"
        local -n __koi_take_target="${2}_${__koi_take_field}"
        for __koi_take_key in "${!__koi_take_source[@]}"; do
            __koi_take_target[$__koi_take_key]=${__koi_take_source[$__koi_take_key]}
        done
    done

    local -n __koi_take_source_valid="${1}_spec_valid" __koi_take_target_valid="${2}_spec_valid"
    __koi_take_target_valid=$__koi_take_source_valid
}

# Move registration into already-declared parser-local storage
# Usage: koi::internal::take_spec SOURCE_PREFIX TARGET_PREFIX
#   SOURCE_PREFIX  registration buffer to consume
#   TARGET_PREFIX  typed storage receiving all metadata
koi::internal::take_spec() {
    koi::internal::copy_spec "$1" "$2"
    koi::internal::clear_spec "$1"
}

# Parse a consumed spec and prepare dispatch without invoking business logic
# Usage: koi::internal::parse_spec PREFIX ROOT PATH MESSAGE UNKNOWN_HELP HANDLER_VAR COMMAND_VAR REMAINING_ARRAY "$@"
#   PREFIX           parser-local spec prefix
#   ROOT             1 for runner help/routing behavior, otherwise 0
#   PATH             selected CLI path, or empty for direct calls
#   MESSAGE          root no-command error, or empty for help
#   UNKNOWN_HELP     1 to allow root unknown-command help
#   HANDLER_VAR      receives the selected child handler
#   COMMAND_VAR      receives the selected child command name
#   REMAINING_ARRAY  receives exact arguments following the child name
#   $@               options and optional child command to parse
# Returns 0 to continue, 1 for help, 2 on error, or 3 for prepared dispatch
koi::internal::parse_spec() {
    local __koi_engine_prefix=$1 __koi_engine_root=$2 __koi_engine_path=$3
    local __koi_engine_message=$4 __koi_engine_unknown_help=$5
    local -n __koi_engine_handler=$6 __koi_engine_command=$7 __koi_engine_remaining=$8
    shift 8
    local -n __koi_commands="${__koi_engine_prefix}_commands"
    local -n __koi_handlers="${__koi_engine_prefix}_handlers"
    local -n __koi_args="${__koi_engine_prefix}_args"
    local -n __koi_arg_kinds="${__koi_engine_prefix}_arg_kinds"
    local -n __koi_arg_cardinalities="${__koi_engine_prefix}_arg_cardinalities"
    local -n __koi_arg_requireds="${__koi_engine_prefix}_arg_requireds"
    local -n __koi_arg_defaults="${__koi_engine_prefix}_arg_defaults"
    local -n __koi_spec_valid="${__koi_engine_prefix}_spec_valid"
    local -n __koi_engine_meta="${__koi_engine_prefix}_meta"
    local -a __koi_engine_tail=()
    local __koi_engine_child __koi_engine_token
    if (( ! __koi_spec_valid )); then
        return 2
    fi

    local __koi_engine_api=koi::parse
    if (( __koi_engine_root )); then
        __koi_engine_api=koi::run
    fi

    # validate root policy before layout removes unavailable help features
    if (( __koi_engine_root )) &&
        [[ ${__koi_engine_meta[verbose-help]-false} == true &&
           ${__koi_engine_meta[help-subcommand]-true} == false ]]; then
        koi::internal::author_error "$__koi_engine_api" 'verbose-help requires help-subcommand true'
        return 2
    fi

    # validate the completed layout and resolve help availability before parsing
    koi::internal::finalize_spec "$__koi_engine_prefix" "$__koi_engine_api" || return 2
    local __koi_engine_command_root=$((__koi_engine_root && ! ${__koi_engine_meta[positionals]}))

    if (( __koi_engine_meta[builtin] )) && [[ ${__koi_handlers[help]+present} ]]; then
        koi::internal::author_error "$__koi_engine_api" "command 'help' conflicts with built-in help, use 'koi::config help-subcommand false' at script scope"
        return 2
    fi

    # reject missing registered handlers before help or command selection
    for __koi_engine_child in "${__koi_commands[@]}"; do
        if ! declare -F -- "${__koi_handlers[$__koi_engine_child]}" >/dev/null; then
            koi::internal::author_error "$__koi_engine_api" "missing handler '${__koi_handlers[$__koi_engine_child]}' for command '$__koi_engine_child'"
            return 2
        fi
    done

    # only the collector's matched invocation can stop here to capture a spec
    if (( ${__koi_collect_matches:-0} )); then
        if [[ -z ${__koi_inspection_sink-} ]]; then
            koi::internal::author_error "$__koi_engine_api" 'inspection collector requires a sink'
            return 2
        fi
        koi::internal::copy_spec "$__koi_engine_prefix" "$__koi_inspection_sink"
        __koi_inspection_received=1
        return 1
    fi

    # keep scanned values and presence separate until all checks pass
    local __koi_parse_result
    local __koi_parse_error_category=user
    local __koi_parse_dest __koi_parse_error='' __koi_parse_declaration __koi_parse_attributes
    local -A __koi_parse_values=() __koi_parse_seen=() __koi_parse_elements=() __koi_parse_counts=()

    # pass variable names so the scanner can fill these through namerefs
    if koi::internal::scan_args "$__koi_engine_prefix" __koi_parse_values __koi_parse_seen __koi_parse_error __koi_engine_tail "$__koi_engine_command_root" __koi_parse_error_category "$@"; then
        __koi_parse_result=0
    else
        __koi_parse_result=$?
    fi

    # trigger the caller's guard while returning success from its function
    if (( __koi_parse_result == 1 )); then
        koi::internal::print_help "$__koi_engine_prefix" "$__koi_engine_root" "$__koi_engine_path"
        return 1
    fi

    # report input errors only after giving help a chance to take precedence
    if [[ -n $__koi_parse_error ]]; then
        if [[ $__koi_parse_error_category == author ]]; then
            koi::internal::author_error "$__koi_engine_api" "$__koi_parse_error"
        else
            koi::internal::user_error "$__koi_parse_error"
        fi
        return 2
    fi

    # resolve the child command without interpreting its remaining arguments
    if (( ${#__koi_engine_tail[@]} )); then
        __koi_engine_command=${__koi_engine_tail[0]}
        __koi_engine_remaining=("${__koi_engine_tail[@]:1}")
        if [[ $__koi_engine_command == help ]] && (( __koi_engine_meta[builtin] )); then
            local __koi_builtin_help=0 __koi_builtin_verbose=0 __koi_builtin_invalid=0
            for __koi_engine_token in "${__koi_engine_remaining[@]}"; do
                case $__koi_engine_token in
                    -h|--help)
                        __koi_builtin_help=$((__koi_builtin_help + 1))
                        ;;
                    -v|--verbose)
                        __koi_builtin_verbose=$((__koi_builtin_verbose + 1))
                        ;;
                    *)
                        __koi_builtin_invalid=1
                        ;;
                esac
            done

            if (( __koi_builtin_invalid || __koi_builtin_help > 1 || __koi_builtin_verbose > 1 )); then
                if (( ${#__koi_engine_remaining[@]} == 1 )); then
                    koi::internal::user_error "unsupported positional argument: '${__koi_engine_remaining[0]}'"
                else
                    koi::internal::user_error 'unsupported help arguments'
                fi
                return 2
            fi

            # Resolve help before checking whether verbose traversal is available.
            if (( __koi_builtin_help )); then
                koi::internal::print_help_command "$__koi_engine_prefix" "$__koi_engine_root" "$__koi_engine_path"
            elif (( __koi_builtin_verbose )); then
                if (( ! __koi_engine_root || ! __koi_engine_meta[verbose] )); then
                    koi::internal::user_error "unsupported positional argument: '${__koi_engine_remaining[0]}'"
                    return 2
                fi
                __koi_engine_meta[hints]=0
                local -a __koi_walk_ancestors=()
                koi::internal::walk_spec "$__koi_engine_prefix" || return 2
            else
                koi::internal::print_help "$__koi_engine_prefix" "$__koi_engine_root" "$__koi_engine_path"
            fi
            return 1
        fi

        # reject unregistered commands unless the root's unknown-command help override applies
        if [[ -z $__koi_engine_command || ! ${__koi_handlers[$__koi_engine_command]+present} ]]; then
            if (( __koi_engine_root && __koi_engine_unknown_help )); then
                for __koi_engine_token in "${__koi_engine_remaining[@]}"; do
                    case $__koi_engine_token in
                        --)
                            break
                            ;;
                        -h|--help)
                            koi::internal::print_help "$__koi_engine_prefix" 1 "$__koi_engine_path"
                            return 1
                            ;;
                    esac
                done
            fi
            koi::internal::user_error "unknown command '$__koi_engine_command'"
            return 2
        fi
        __koi_engine_handler=${__koi_handlers[$__koi_engine_command]}
    elif (( __koi_engine_command_root || ${#__koi_commands[@]} )); then
        # honor the configured error message when no root command was supplied
        if (( __koi_engine_root )) && [[ -n $__koi_engine_message ]]; then
            koi::internal::user_error "$__koi_engine_message"
            return 2
        fi

        koi::internal::print_help "$__koi_engine_prefix" "$__koi_engine_root" "$__koi_engine_path"
        return 1
    fi

    # check presence and fill omitted values without touching user variables
    for __koi_parse_dest in "${__koi_args[@]}"; do
        # check if required but was not included
        if [[ ${__koi_arg_requireds[$__koi_parse_dest]} == 1 && ! ${__koi_parse_seen[$__koi_parse_dest]+present} ]]; then
            koi::internal::user_error "missing required argument: '$__koi_parse_dest'"
            return 2
        fi

    done

    koi::internal::check_relationships "$__koi_engine_prefix" __koi_parse_seen || return 2

    for __koi_parse_dest in "${__koi_args[@]}"; do
        # determine default, if one is available
        if [[ ! ${__koi_parse_seen[$__koi_parse_dest]+present} ]]; then
            if [[ ${__koi_arg_kinds[$__koi_parse_dest]} == flag ]]; then
                __koi_parse_values[$__koi_parse_dest]=0
            else
                __koi_parse_values[$__koi_parse_dest]=${__koi_arg_defaults[$__koi_parse_dest]-}
            fi
        fi

        # accept only destination attributes that preserve literal values
        if __koi_parse_declaration=$(declare -p "$__koi_parse_dest" 2>/dev/null); then
            __koi_parse_attributes=${__koi_parse_declaration#declare -}
            __koi_parse_attributes=${__koi_parse_attributes%% *}

            # require the declared cardinality's type, allowing only the export attribute
            if { [[ ${__koi_arg_cardinalities[$__koi_parse_dest]} == array ]] &&
                 [[ $__koi_parse_attributes != a && $__koi_parse_attributes != ax ]]; } ||
               { [[ ${__koi_arg_cardinalities[$__koi_parse_dest]} != array ]] &&
                 [[ $__koi_parse_attributes != - && $__koi_parse_attributes != x ]]; }; then
                koi::internal::author_error "$__koi_engine_api" "incompatible destination: '$__koi_parse_dest'"
                return 2
            fi
        fi
    done

    local __koi_parse_index
    local -a __koi_parse_array=()
    # validate effective values only after the complete invocation is well formed
    for __koi_parse_dest in "${__koi_args[@]}"; do
        if [[ ${__koi_arg_cardinalities[$__koi_parse_dest]} == array ]]; then
            for ((__koi_parse_index=0; __koi_parse_index<${__koi_parse_counts[$__koi_parse_dest]:-0}; __koi_parse_index++)); do
                koi::internal::validate_value "$__koi_engine_prefix" "$__koi_engine_api" "$__koi_parse_dest" "${__koi_parse_elements[$__koi_parse_dest,$__koi_parse_index]}" 0 || return 2
            done
        elif [[ ${__koi_parse_seen[$__koi_parse_dest]+present} ]]; then
            koi::internal::validate_value "$__koi_engine_prefix" "$__koi_engine_api" "$__koi_parse_dest" "${__koi_parse_values[$__koi_parse_dest]}" 0 || return 2
        elif [[ ${__koi_arg_defaults[$__koi_parse_dest]+present} ]]; then
            koi::internal::validate_value "$__koi_engine_prefix" "$__koi_engine_api" "$__koi_parse_dest" "${__koi_parse_values[$__koi_parse_dest]}" 1 || return 2
        fi
    done

    # assign only after every value and destination has been checked
    for __koi_parse_dest in "${__koi_args[@]}"; do
        # replace the complete array through the nearest visible destination
        if [[ ${__koi_arg_cardinalities[$__koi_parse_dest]} == array ]]; then
            __koi_parse_array=()
            for ((__koi_parse_index=0; __koi_parse_index<${__koi_parse_counts[$__koi_parse_dest]:-0}; __koi_parse_index++)); do
                __koi_parse_array+=("${__koi_parse_elements[$__koi_parse_dest,$__koi_parse_index]}")
            done

            local -n __koi_parse_target=$__koi_parse_dest
            __koi_parse_target=("${__koi_parse_array[@]}")
            continue
        fi

        if ! printf -v "$__koi_parse_dest" '%s' "${__koi_parse_values[$__koi_parse_dest]}"; then
            # in the rare case that we couldn't assign the destination's value
            koi::internal::author_error "$__koi_engine_api" "cannot assign destination: '$__koi_parse_dest'"
            return 2
        fi
    done

    # signal prepared dispatch so the caller can discard the spec before execution
    if [[ -n $__koi_engine_handler ]]; then
        return 3
    fi
    return 0
}

# Report a script-author error with its public API context
# Usage: koi::internal::author_error API MESSAGE
#   API      public API responsible for the failure
#   MESSAGE  literal diagnostic text
# Writes to stderr and returns 2
koi::internal::author_error() {
    printf 'koi: %s: %s\n' "$1" "$2" >&2
    return 2
}

# Report a script-user error with the configured application name
# Usage: koi::internal::user_error MESSAGE
#   MESSAGE  literal diagnostic text
# Writes to stderr and returns 2, defaulting the name to koi
koi::internal::user_error() {
    printf '%s: %s\n' "${__koi_config[name]:-koi}" "$1" >&2
    return 2
}

# Invalidate registration and report a script-author error
# Usage: koi::internal::spec_error PREFIX API MESSAGE
#   PREFIX   owning registration buffer prefix
#   API      public API responsible for the failure
#   MESSAGE  literal diagnostic text
# Returns 2
koi::internal::spec_error() {
    local -n __koi_error_valid="${1}_spec_valid"
    shift
    __koi_error_valid=0
    koi::internal::author_error "$@"
    return 2
}

# Validate an argument destination without modifying the registry
# Usage: koi::internal::validate_arg_destination PREFIX DEST
#   PREFIX  registration buffer prefix
#   DEST    the destination identifier to validate
# Returns 2 and marks the spec invalid on failure
koi::internal::validate_arg_destination() {
    local __koi_validation_prefix=$1
    local __koi_validation_dest=$2 __koi_reserved
    local -a __koi_reserved_names=(
        BASH BASH_ENV BASH_SUBSHELL BASHPID BASH_VERSINFO BASH_VERSION CDPATH
        DIRSTACK EDITOR EUID FUNCNAME GLOBIGNORE GROUPS HOME HOSTNAME
        HOSTTYPE IFS IGNOREEOF LC_COLLATE LC_CTYPE LINENO MACHTYPE OLDPWD
        OSTYPE PATH PIPESTATUS PPID PROMPT_COMMAND PS1 PS2 PS3 PS4 PWD
        REPLY SECONDS SHELLOPTS SHLVL TMOUT UID koi_status
    )

    if [[ ! $__koi_validation_dest =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ || $__koi_validation_dest == __koi_* ]]; then
        koi::internal::spec_error "$__koi_validation_prefix" koi::add_arg "invalid destination: '$__koi_validation_dest'"
        return 2
    fi

    for __koi_reserved in "${__koi_reserved_names[@]}"; do
        if [[ $__koi_validation_dest == "$__koi_reserved" ]]; then
            koi::internal::spec_error "$__koi_validation_prefix" koi::add_arg "reserved destination: '$__koi_validation_dest'"
            return 2
        fi
    done
    return 0
}

# Validate completed argument metadata and check for registration collisions
# Usage: koi::internal::validate_arg_spec PREFIX DEST VALUES_ARRAY SEEN_ARRAY
#   PREFIX        registration buffer prefix
#   DEST          the validated destination identifier
#   VALUES_ARRAY  the name of the associative declaration-value array
#   SEEN_ARRAY    the name of the associative parameter-presence array
# Returns 2 and marks the spec invalid on failure, does not modify metadata
koi::internal::validate_arg_spec() {
    local __koi_validation_prefix=$1
    local -n __koi_args="${__koi_validation_prefix}_args"
    local -n __koi_arg_shorts="${__koi_validation_prefix}_arg_shorts"
    local -n __koi_arg_longs="${__koi_validation_prefix}_arg_longs"
    local -n __koi_arg_kinds="${__koi_validation_prefix}_arg_kinds"
    local -n __koi_arg_cardinalities="${__koi_validation_prefix}_arg_cardinalities"
    local __koi_validation_dest=$2 __koi_validation_existing __koi_validation_reserved
    local -n __koi_validation_values=$3 __koi_validation_seen=$4

    if [[ -z ${__koi_validation_values[kind]} ]]; then
        koi::internal::spec_error "$__koi_validation_prefix" koi::add_arg 'exactly one of --flag, --option, or --positional is required'
        return 2
    fi

    if [[ -z ${__koi_validation_values[description]} ]]; then
        koi::internal::spec_error "$__koi_validation_prefix" koi::add_arg 'nonempty description required'
        return 2
    fi

    if [[ ${__koi_validation_values[kind]} == positional ]]; then
        if [[ ${__koi_validation_seen[short]+present} || ${__koi_validation_seen[long]+present} ]]; then
            koi::internal::spec_error "$__koi_validation_prefix" koi::add_arg 'positionals cannot have short or long spellings'
            return 2
        fi
    elif [[ ! ${__koi_validation_seen[short]+present} && ! ${__koi_validation_seen[long]+present} ]]; then
        koi::internal::spec_error "$__koi_validation_prefix" koi::add_arg 'short or long spelling required'
        return 2
    fi

    if [[ ${__koi_validation_seen[short]+present} ]]; then
        if [[ ! ${__koi_validation_values[short]} =~ ^[a-zA-Z]$ || ${__koi_validation_values[short]} == h ]]; then
            koi::internal::spec_error "$__koi_validation_prefix" koi::add_arg "invalid or reserved short spelling: '${__koi_validation_values[short]}'"
            return 2
        fi
    fi

    if [[ ${__koi_validation_seen[long]+present} ]]; then
        if [[ ! ${__koi_validation_values[long]} =~ ^[a-zA-Z][a-zA-Z0-9_-]*$ ]]; then
            koi::internal::spec_error "$__koi_validation_prefix" koi::add_arg "invalid or reserved long spelling: '${__koi_validation_values[long]}'"
            return 2
        fi

        for __koi_validation_reserved in "${__koi_reserved_longs[@]}"; do
            if [[ ${__koi_validation_values[long]} == "$__koi_validation_reserved" ]]; then
                koi::internal::spec_error "$__koi_validation_prefix" koi::add_arg "invalid or reserved long spelling: '${__koi_validation_values[long]}'"
                return 2
            fi
        done
    fi

    if [[ ${__koi_validation_seen[cardinality]+present} && ${__koi_validation_values[kind]} == flag ]]; then
        koi::internal::spec_error "$__koi_validation_prefix" koi::add_arg 'cardinality requires an option or positional'
        return 2
    fi

    if [[ ${__koi_validation_values[cardinality]} == array && ${__koi_validation_seen[default]+present} ]]; then
        koi::internal::spec_error "$__koi_validation_prefix" koi::add_arg 'arrays cannot have defaults'
        return 2
    fi

    if [[ ${__koi_validation_seen[display_name]+present} ]]; then
        if [[ ${__koi_validation_values[kind]} == flag || -z ${__koi_validation_values[display_name]} ]]; then
            koi::internal::spec_error "$__koi_validation_prefix" koi::add_arg 'nonempty display name requires an option or positional'
            return 2
        fi
    fi

    if [[ ${__koi_validation_seen[default]+present} ]]; then
        if [[ ${__koi_validation_values[kind]} == flag || ${__koi_validation_values[required]} == 1 ]]; then
            koi::internal::spec_error "$__koi_validation_prefix" koi::add_arg 'defaults require an optional option or positional'
            return 2
        fi
    fi

    if [[ ${__koi_arg_kinds[$__koi_validation_dest]+present} ]]; then
        koi::internal::spec_error "$__koi_validation_prefix" koi::add_arg "duplicate destination: '$__koi_validation_dest'"
        return 2
    fi

    for __koi_validation_existing in "${__koi_args[@]}"; do
        if [[ -n ${__koi_validation_values[short]} && ${__koi_validation_values[short]} == "${__koi_arg_shorts[$__koi_validation_existing]}" ]]; then
            koi::internal::spec_error "$__koi_validation_prefix" koi::add_arg "duplicate short spelling: '${__koi_validation_values[short]}'"
            return 2
        fi
        if [[ -n ${__koi_validation_values[long]} && ${__koi_validation_values[long]} == "${__koi_arg_longs[$__koi_validation_existing]}" ]]; then
            koi::internal::spec_error "$__koi_validation_prefix" koi::add_arg "duplicate long spelling: '${__koi_validation_values[long]}'"
            return 2
        fi
    done
    return 0
}

# Check a relationship member without changing successful registration
# Usage: koi::internal::check_relationship_arg PREFIX API DEST
#   PREFIX  owning registration buffer
#   API     declaration responsible for any diagnostic
#   DEST    previously registered flag or option destination
# Returns 2 and invalidates registration for an invalid member
koi::internal::check_relationship_arg() {
    local -n __koi_relation_kinds="${1}_arg_kinds"
    if [[ ! $3 =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] || [[ ! ${__koi_relation_kinds[$3]+present} ]]; then
        koi::internal::spec_error "$1" "$2" "unknown argument: '$3'"
        return 2
    fi

    if [[ ${__koi_relation_kinds[$3]} == positional ]]; then
        koi::internal::spec_error "$1" "$2" "positionals cannot participate in relationships: '$3'"
        return 2
    fi
    return 0
}

# Reject direct prerequisites between members of the same exclusive group
# Usage: koi::internal::check_relationship_layout PREFIX
#   PREFIX  consumed spec containing complete group and dependency declarations
# Returns 2 for a direct contradiction, including during help and inspection
koi::internal::check_relationship_layout() {
    local -n __koi_layout_groups="${1}_arg_groups" __koi_layout_types="${1}_group_types"
    local -n __koi_layout_sources="${1}_dependency_sources" __koi_layout_targets="${1}_dependency_targets"
    local __koi_layout_edge __koi_layout_source_group __koi_layout_target_group
    for __koi_layout_edge in "${!__koi_layout_sources[@]}"; do
        __koi_layout_source_group=${__koi_layout_groups[${__koi_layout_sources[$__koi_layout_edge]}]-}
        __koi_layout_target_group=${__koi_layout_groups[${__koi_layout_targets[$__koi_layout_edge]}]-}
        if [[ -n $__koi_layout_source_group && $__koi_layout_source_group == "$__koi_layout_target_group" &&
              ${__koi_layout_types[$__koi_layout_source_group]} == xor ]]; then
            koi::internal::author_error koi::add_dependency "'${__koi_layout_sources[$__koi_layout_edge]}' cannot require '${__koi_layout_targets[$__koi_layout_edge]}' in the same XOR group"
            return 2
        fi
    done
    return 0
}

# Check explicit member presence before resolving defaults or invoking validators
# Usage: koi::internal::check_relationships PREFIX SEEN_ARRAY
#   PREFIX      consumed spec containing groups and dependency edges
#   SEEN_ARRAY  associative set of explicitly supplied destinations
# Returns 2 on the first group or dependency violation, otherwise 0
koi::internal::check_relationships() {
    local -n __koi_relation_seen=$2
    local -n __koi_relation_types="${1}_group_types" __koi_relation_requireds="${1}_group_requireds"
    local -n __koi_relation_offsets="${1}_group_offsets" __koi_relation_counts="${1}_group_counts"
    local -n __koi_relation_members="${1}_group_members"
    local -n __koi_relation_sources="${1}_dependency_sources" __koi_relation_targets="${1}_dependency_targets"
    local __koi_relation_group __koi_relation_index __koi_relation_count __koi_relation_dest
    local __koi_relation_list __koi_relation_reason
    for __koi_relation_group in "${!__koi_relation_types[@]}"; do
        __koi_relation_count=0
        __koi_relation_list=''
        __koi_relation_reason=''
        for ((__koi_relation_index=0; __koi_relation_index<__koi_relation_counts[$__koi_relation_group]; __koi_relation_index++)); do
            __koi_relation_dest=${__koi_relation_members[${__koi_relation_offsets[$__koi_relation_group]}+__koi_relation_index]}
            __koi_relation_list+="${__koi_relation_list:+, }'$__koi_relation_dest'"
            if [[ ${__koi_relation_seen[$__koi_relation_dest]+present} ]]; then
                __koi_relation_count=$((__koi_relation_count + 1))
            fi
        done

        case ${__koi_relation_types[$__koi_relation_group]} in
            xor)
                if (( __koi_relation_count > 1 )); then
                    __koi_relation_reason="at most one of $__koi_relation_list may be supplied"
                elif (( __koi_relation_requireds[$__koi_relation_group] && __koi_relation_count == 0 )); then
                    __koi_relation_reason="exactly one of $__koi_relation_list is required"
                fi
                ;;
            or)
                if (( __koi_relation_count == 0 )); then
                    __koi_relation_reason="at least one of $__koi_relation_list is required"
                fi
                ;;
            and)
                if (( __koi_relation_count != __koi_relation_counts[$__koi_relation_group] &&
                      (__koi_relation_requireds[$__koi_relation_group] || __koi_relation_count > 0) )); then
                    __koi_relation_reason="all of $__koi_relation_list must be supplied together"
                fi
                ;;
        esac

        if [[ -n $__koi_relation_reason ]]; then
            koi::internal::user_error "$__koi_relation_reason"
            return 2
        fi
    done

    for __koi_relation_index in "${!__koi_relation_sources[@]}"; do
        if [[ ${__koi_relation_seen[${__koi_relation_sources[$__koi_relation_index]}]+present} &&
              ! ${__koi_relation_seen[${__koi_relation_targets[$__koi_relation_index]}]+present} ]]; then
            koi::internal::user_error "'${__koi_relation_sources[$__koi_relation_index]}' requires '${__koi_relation_targets[$__koi_relation_index]}'"
            return 2
        fi
    done

    return 0
}

# Validate positional layout and derive local help availability
# Usage: koi::internal::finalize_spec PREFIX API
#   PREFIX  consumed spec prefix
#   API     public parsing API responsible for layout validation
# Returns 2 for invalid layouts, including during help or inspection
koi::internal::finalize_spec() {
    local __koi_layout_api=$2
    local __koi_layout_prefix=$1 __koi_layout_dest __koi_layout_optional=0
    local -n __koi_layout_args="${__koi_layout_prefix}_args"
    local -n __koi_layout_kinds="${__koi_layout_prefix}_arg_kinds"
    local -n __koi_layout_requireds="${__koi_layout_prefix}_arg_requireds"
    local -n __koi_layout_commands="${__koi_layout_prefix}_commands"
    local -n __koi_layout_meta="${__koi_layout_prefix}_meta"
    local -n __koi_layout_cardinalities="${__koi_layout_prefix}_arg_cardinalities"
    local __koi_layout_array=0
    __koi_layout_meta[positionals]=0

    local -n __koi_layout_validator_dests="${1}_validator_dests"
    local -n __koi_layout_validator_functions="${1}_validator_functions"
    local __koi_layout_validator_index __koi_layout_callback
    for __koi_layout_validator_index in "${!__koi_layout_validator_dests[@]}"; do
        __koi_layout_callback=${__koi_layout_validator_functions[$__koi_layout_validator_index]}
        if [[ -n $__koi_layout_callback ]] && ! declare -F -- "$__koi_layout_callback" >/dev/null; then
            koi::internal::author_error koi::add_validator "argument '${__koi_layout_validator_dests[$__koi_layout_validator_index]}': callback '$__koi_layout_callback' is not a Bash function"
            return 2
        fi
    done

    koi::internal::check_relationship_layout "$1" || return 2

    # inspect positionals in declaration order, ignoring named arguments
    for __koi_layout_dest in "${__koi_layout_args[@]}"; do
        if [[ ${__koi_layout_kinds[$__koi_layout_dest]} != positional ]]; then
            continue
        fi
    
        if (( __koi_layout_array )); then
            koi::internal::author_error "$__koi_layout_api" 'positional array must be the final positional'
            return 2
        fi

        if [[ ${__koi_layout_cardinalities[$__koi_layout_dest]} == array ]]; then
            if (( __koi_layout_optional )); then
                koi::internal::author_error "$__koi_layout_api" 'positional array cannot coexist with optional scalar positionals'
                return 2
            fi
            __koi_layout_array=1
        fi

        # count positional slots and reject required slots after optional ones
        __koi_layout_meta[positionals]=$((__koi_layout_meta[positionals] + 1))
        if [[ ${__koi_layout_requireds[$__koi_layout_dest]} == 1 ]]; then
            if (( __koi_layout_optional )); then
                koi::internal::author_error "$__koi_layout_api" 'required positionals must precede optional positionals'
                return 2
            fi
        else
            __koi_layout_optional=1
        fi
    done

    # reserve bare tokens for child selection in contexts with application commands
    if (( __koi_layout_meta[positionals] )); then
        if (( ${#__koi_layout_commands[@]} )); then
            koi::internal::author_error "$__koi_layout_api" 'positionals cannot coexist with application child commands'
            return 2
        fi
    fi

    # offer free help commands only in branches with application children
    if (( ${#__koi_layout_commands[@]} == 0 )); then
        __koi_layout_meta[builtin]=0
        __koi_layout_meta[verbose]=0
    fi

    return 0
}

# Scan script tokens into temporary values while allowing help to override errors. Array
# elements and counts use invocation-local __koi_parse_elements/counts storage.
# Usage: koi::internal::scan_args PREFIX VALUES_ARRAY SEEN_ARRAY ERROR_VAR TAIL_ARRAY ROOT CATEGORY_VAR "$@"
#   PREFIX        parser-local spec prefix
#   VALUES_ARRAY  associative output array of scalar values
#   SEEN_ARRAY    associative output array tracking explicit presence
#   ERROR_VAR     first diagnostic, or empty text
#   TAIL_ARRAY    receives the child command and remaining tokens
#   ROOT          1 to recognize a command even with no registered children
#   CATEGORY_VAR  receives author or user for the first diagnostic
#   $@            application arguments
# Returns 1 for help or 0 after scanning without assigning user destinations
# namerefs point to associative arrays whose keys require string expansion
# shellcheck disable=SC2004
koi::internal::scan_args() {
    local __koi_scan_prefix=$1
    local -n __koi_commands="${__koi_scan_prefix}_commands"
    local -n __koi_args="${__koi_scan_prefix}_args"
    local -n __koi_arg_shorts="${__koi_scan_prefix}_arg_shorts"
    local -n __koi_arg_longs="${__koi_scan_prefix}_arg_longs"
    local -n __koi_arg_kinds="${__koi_scan_prefix}_arg_kinds"
    local -n __koi_arg_cardinalities="${__koi_scan_prefix}_arg_cardinalities"
    local -n __koi_scan_meta="${__koi_scan_prefix}_meta"
    local -n __koi_scan_values=$2 __koi_scan_seen=$3 __koi_scan_error=$4 __koi_scan_tail=$5
    local __koi_scan_root=$6
    local -n __koi_scan_elements=__koi_parse_elements __koi_scan_counts=__koi_parse_counts
    local -n __koi_scan_category=$7
    local __koi_scan_ignore=0 __koi_scan_surplus=''
    local __koi_scan_step=0 __koi_scan_error_step=0 __koi_scan_surplus_step=0
    local __koi_scan_duplicates=0 __koi_scan_duplicate=''
    if [[ ${__koi_scan_meta[ignore-unknown-positionals]-false} == true ]]; then
        __koi_scan_ignore=1
    fi
    if [[ ${__koi_scan_meta[error-on-scalar-duplicates]-false} == true ]]; then
        __koi_scan_duplicates=1
    fi
    shift 7

    local __koi_scan_dest __koi_scan_token __koi_scan_value __koi_scan_char
    local __koi_scan_index __koi_scan_cluster_valid __koi_scan_cluster_help
    local __koi_scan_positional=0 __koi_scan_slot=0
    local -a __koi_scan_positionals=()
    local -A __koi_scan_lookup=()
    local -a __koi_scan_cluster=()

    # map spellings and preserve positional declaration order separately
    for __koi_scan_dest in "${__koi_args[@]}"; do
        if [[ ${__koi_arg_kinds[$__koi_scan_dest]} == positional ]]; then
            __koi_scan_positionals+=("$__koi_scan_dest")
        fi

        if [[ -n ${__koi_arg_shorts[$__koi_scan_dest]} ]]; then
            __koi_scan_lookup[-${__koi_arg_shorts[$__koi_scan_dest]}]=$__koi_scan_dest
        fi

        if [[ -n ${__koi_arg_longs[$__koi_scan_dest]} ]]; then
            __koi_scan_lookup[--${__koi_arg_longs[$__koi_scan_dest]}]=$__koi_scan_dest
        fi
    done

    # keep the first error but continue looking for a help request
    while (( $# )); do
        __koi_scan_step=$((__koi_scan_step + 1))
        __koi_scan_token=$1
        shift

        if (( __koi_scan_root || ${#__koi_commands[@]} || __koi_scan_meta[builtin] )) &&
            { (( __koi_scan_positional )) || [[ $__koi_scan_token != -* ]]; }; then
            # forward the selected command and its remaining tokens without parsing them
            __koi_scan_tail=("$__koi_scan_token" "$@")
            break
        elif (( __koi_scan_positional )) || [[ $__koi_scan_token != -* || $__koi_scan_token == - ]]; then
            # fill the next positional slot with bare data or any token after --
            if (( __koi_scan_slot < ${#__koi_scan_positionals[@]} )); then
                __koi_scan_dest=${__koi_scan_positionals[$__koi_scan_slot]}

                # keep the array slot open while scalar slots advance after one value
                if [[ ${__koi_arg_cardinalities[$__koi_scan_dest]} == array ]]; then
                    __koi_scan_elements[$__koi_scan_dest,${__koi_scan_counts[$__koi_scan_dest]:-0}]=$__koi_scan_token
                    __koi_scan_counts[$__koi_scan_dest]=$((${__koi_scan_counts[$__koi_scan_dest]:-0} + 1))
                else
                    __koi_scan_slot=$((__koi_scan_slot + 1))
                    __koi_scan_values[$__koi_scan_dest]=$__koi_scan_token
                fi
                __koi_scan_seen[$__koi_scan_dest]=1
            elif [[ -z $__koi_scan_surplus ]]; then
                # defer surplus data so help can take precedence
                __koi_scan_surplus="unsupported positional argument: '$__koi_scan_token'"
                __koi_scan_surplus_step=$__koi_scan_step
            fi
        elif [[ $__koi_scan_token == -h || $__koi_scan_token == --help ]]; then
            # stop scanning and request help
            return 1
        elif [[ $__koi_scan_token == -- ]]; then
            # end option recognition for the remaining tokens
            __koi_scan_positional=1
        elif [[ -n $__koi_scan_token && ${__koi_scan_lookup[$__koi_scan_token]+present} ]]; then
            # resolve an exact spelling to its destination and value
            __koi_scan_dest=${__koi_scan_lookup[$__koi_scan_token]}
            __koi_scan_value=1
            if [[ ${__koi_arg_kinds[$__koi_scan_dest]} == option ]]; then
                # options consume a value instead of storing 1
                if (( $# == 0 )); then
                    # reject an option with no remaining value token
                    if [[ -z $__koi_scan_error ]]; then
                        __koi_scan_error_step=$__koi_scan_step
                        __koi_scan_error="missing value for '$__koi_scan_token'"
                    fi
                    continue
                fi

                if [[ $1 == -h || $1 == --help ]]; then
                    # help overrides an apparent option value
                    return 1
                fi

                # consume the next token literally, except for help
                __koi_scan_value=$1
                shift
            fi

            if [[ ${__koi_arg_cardinalities[$__koi_scan_dest]} != array && ${__koi_scan_seen[$__koi_scan_dest]+present} && -z $__koi_scan_duplicate ]]; then
                # remember the first repeated destination
                __koi_scan_duplicate=$__koi_scan_dest
            fi

            if [[ ${__koi_arg_cardinalities[$__koi_scan_dest]} == array ]]; then
                # append each literal option value in occurrence order across aliases
                __koi_scan_elements[$__koi_scan_dest,${__koi_scan_counts[$__koi_scan_dest]:-0}]=$__koi_scan_value
                __koi_scan_counts[$__koi_scan_dest]=$((${__koi_scan_counts[$__koi_scan_dest]:-0} + 1))
            else
                __koi_scan_values[$__koi_scan_dest]=$__koi_scan_value
            fi
            __koi_scan_seen[$__koi_scan_dest]=1
        elif [[ $__koi_scan_token == -?* && $__koi_scan_token != --* && ${#__koi_scan_token} -gt 2 ]]; then
            # validate the whole cluster before accepting any of its flags
            __koi_scan_cluster=()
            __koi_scan_cluster_valid=1
            __koi_scan_cluster_help=0

            for (( __koi_scan_index=1; __koi_scan_index < ${#__koi_scan_token}; __koi_scan_index++ )); do
                __koi_scan_char=${__koi_scan_token:__koi_scan_index:1}
                if [[ $__koi_scan_char == h ]]; then
                    # defer clustered help until the whole cluster is valid
                    __koi_scan_cluster_help=1
                elif [[ ${__koi_scan_lookup[-$__koi_scan_char]+present} ]]; then
                    # resolve this cluster member to a registered argument
                    __koi_scan_dest=${__koi_scan_lookup[-$__koi_scan_char]}
                    if [[ ${__koi_arg_kinds[$__koi_scan_dest]} != flag ]]; then
                        # value-taking options cannot appear in clusters
                        __koi_scan_cluster_valid=0
                    fi
                    __koi_scan_cluster+=("$__koi_scan_dest")
                else
                    # unknown letters make the whole cluster invalid
                    __koi_scan_cluster_valid=0
                fi
            done

            if (( ! __koi_scan_cluster_valid )); then
                # reject the cluster without accepting any members
                if [[ -z $__koi_scan_error ]]; then
                    __koi_scan_error_step=$__koi_scan_step
                    __koi_scan_error="invalid or ambiguous short cluster: '$__koi_scan_token' (flags only)"
                fi
                continue
            fi

            if (( __koi_scan_cluster_help )); then
                # request help from a valid flags-only cluster
                return 1
            fi

            for __koi_scan_dest in "${__koi_scan_cluster[@]}"; do
                if [[ ${__koi_arg_cardinalities[$__koi_scan_dest]} != array && ${__koi_scan_seen[$__koi_scan_dest]+present} && -z $__koi_scan_duplicate ]]; then
                    # track duplicates within clusters and across spellings
                    __koi_scan_duplicate=$__koi_scan_dest
                fi
                __koi_scan_values[$__koi_scan_dest]=1
                __koi_scan_seen[$__koi_scan_dest]=1
            done
        else
            # reject tokens that match neither an option nor a valid cluster
            if [[ -z $__koi_scan_error ]]; then
                __koi_scan_error_step=$__koi_scan_step
                __koi_scan_error="unsupported positional argument: '$__koi_scan_token'"
            fi
        fi
    done

    # retain original first-error order when surplus data remains an error
    if (( ! __koi_scan_ignore && __koi_scan_surplus_step )) &&
        { [[ -z $__koi_scan_error ]] || (( __koi_scan_surplus_step < __koi_scan_error_step )); }; then
        __koi_scan_category=user
        __koi_scan_error=$__koi_scan_surplus
    fi

    # report duplicate input only after allowing help to take precedence
    if (( __koi_scan_duplicates )) && [[ -n $__koi_scan_duplicate && -z $__koi_scan_error ]]; then
        __koi_scan_error_step=$__koi_scan_step
        __koi_scan_error="duplicate argument: '$__koi_scan_duplicate'"
    fi
    return 0
}

# Print immediate children commands without entering their handlers
# Usage: koi::internal::print_commands PREFIX
#   PREFIX  parser-local spec prefix
koi::internal::print_commands() {
    local __koi_command_prefix=$1
    local -n __koi_commands="${__koi_command_prefix}_commands"
    local -n __koi_descriptions="${__koi_command_prefix}_descriptions"
    local -n __koi_command_meta="${__koi_command_prefix}_meta"
    local -a __koi_command_names=("${__koi_commands[@]}")
    if (( __koi_command_meta[builtin] )); then
        __koi_command_names+=(help)
    fi
    local __koi_root_command __koi_root_description __koi_root_indent __koi_root_first
    local __koi_root_width=0
    for __koi_root_command in "${__koi_command_names[@]}"; do
        if (( ${#__koi_root_command} > __koi_root_width )); then
            __koi_root_width=${#__koi_root_command}
        fi
    done
    printf -v __koi_root_indent '%*s' "$((__koi_root_width + 4))" ''
    printf '\n\nCommands:\n'
    for __koi_root_command in "${__koi_command_names[@]}"; do
        if [[ $__koi_root_command == help ]] && (( __koi_command_meta[builtin] )); then
            __koi_root_description='Show this help'
        else
            __koi_root_description=${__koi_descriptions[$__koi_root_command]}
        fi
        printf -v __koi_root_first '  %-*s  ' "$__koi_root_width" "$__koi_root_command"
        koi::internal::wrap "$__koi_root_description" "$__koi_root_first" "$__koi_root_indent"
    done
}

# Build one selectable usage unit without outer optional brackets
# Usage: koi::internal::usage_atom PREFIX DEST OUTPUT_VAR
#   PREFIX      spec containing argument spellings and cardinalities
#   DEST        flag or option to render
#   OUTPUT_VAR  receives the unit, including any array repetition
koi::internal::usage_atom() {
    local -n __koi_atom_shorts="${1}_arg_shorts" __koi_atom_longs="${1}_arg_longs"
    local -n __koi_atom_kinds="${1}_arg_kinds" __koi_atom_cards="${1}_arg_cardinalities"
    local -n __koi_atom_names="${1}_arg_display_names" __koi_atom_output=$3
    local __koi_atom_value
    if [[ -n ${__koi_atom_shorts[$2]} ]]; then
        __koi_atom_output=-${__koi_atom_shorts[$2]}
    else
        __koi_atom_output=--${__koi_atom_longs[$2]}
    fi

    if [[ ${__koi_atom_kinds[$2]} == option ]]; then
        __koi_atom_value=${__koi_atom_names[$2]:-${__koi_atom_longs[$2]:-$2}}
        __koi_atom_output+=" ${__koi_atom_value^^}"
        if [[ ${__koi_atom_cards[$2]} == array ]]; then
            __koi_atom_output+=" [$__koi_atom_output]..."
        fi
    fi
}

# Print one complete group expression in declaration order
# Usage: koi::internal::print_group_usage PREFIX INDEX
#   PREFIX  spec containing group membership and help metadata
#   INDEX   group to render
koi::internal::print_group_usage() {
    local -n __koi_group_help_types="${1}_group_types" __koi_group_help_requireds="${1}_group_requireds"
    local -n __koi_group_help_offsets="${1}_group_offsets" __koi_group_help_counts="${1}_group_counts"
    local -n __koi_group_help_members="${1}_group_members" __koi_group_help_meta="${1}_meta"
    local __koi_group_help_separator=' | ' __koi_group_help_index __koi_group_help_dest __koi_group_help_atom
    if [[ ${__koi_group_help_types[$2]} == and ]]; then
        __koi_group_help_separator=' & '
    elif [[ ${__koi_group_help_types[$2]} == or ]] && (( ! __koi_group_help_meta[single-pipe] )); then
        __koi_group_help_separator=' || '
    fi

    if (( __koi_group_help_requireds[$2] )); then
        printf '('
    else
        printf '['
    fi

    for ((__koi_group_help_index=0; __koi_group_help_index<__koi_group_help_counts[$2]; __koi_group_help_index++)); do
        if (( __koi_group_help_index )); then
            printf '%s' "$__koi_group_help_separator"
        fi

        __koi_group_help_dest=${__koi_group_help_members[${__koi_group_help_offsets[$2]}+__koi_group_help_index]}
        koi::internal::usage_atom "$1" "$__koi_group_help_dest" __koi_group_help_atom
        printf '%s' "$__koi_group_help_atom"
    done

    if (( __koi_group_help_requireds[$2] )); then
        printf ')'
    else
        printf ']'
    fi
}

# Print ordered direct prerequisites without encoding them in usage
# Usage: koi::internal::print_dependencies PREFIX
#   PREFIX  spec containing dependency edges, spellings, and wrapping settings
# Prints nothing when no dependencies are declared
koi::internal::print_dependencies() {
    local -n __koi_dep_help_sources="${1}_dependency_sources" __koi_dep_help_targets="${1}_dependency_targets"
    local -n __koi_dep_help_shorts="${1}_arg_shorts" __koi_dep_help_longs="${1}_arg_longs"
    local -A __koi_dep_help_seen=()
    local __koi_dep_help_index __koi_dep_help_other __koi_dep_help_source __koi_dep_help_dest
    local __koi_dep_help_text __koi_dep_help_list __koi_dep_help_label
    if (( ${#__koi_dep_help_sources[@]} == 0 )); then
        return 0
    fi

    printf '\nDependencies:\n'
    for __koi_dep_help_index in "${!__koi_dep_help_sources[@]}"; do
        __koi_dep_help_source=${__koi_dep_help_sources[$__koi_dep_help_index]}
        if [[ ${__koi_dep_help_seen[$__koi_dep_help_source]+present} ]]; then
            continue
        fi

        __koi_dep_help_seen[$__koi_dep_help_source]=1
        __koi_dep_help_text=--${__koi_dep_help_longs[$__koi_dep_help_source]}
        if [[ -n ${__koi_dep_help_shorts[$__koi_dep_help_source]} ]]; then
            __koi_dep_help_text=-${__koi_dep_help_shorts[$__koi_dep_help_source]}
        fi

        __koi_dep_help_list=''
        for __koi_dep_help_other in "${!__koi_dep_help_sources[@]}"; do
            if [[ ${__koi_dep_help_sources[$__koi_dep_help_other]} != "$__koi_dep_help_source" ]]; then
                continue
            fi

            __koi_dep_help_dest=${__koi_dep_help_targets[$__koi_dep_help_other]}
            __koi_dep_help_label=--${__koi_dep_help_longs[$__koi_dep_help_dest]}
            if [[ -n ${__koi_dep_help_shorts[$__koi_dep_help_dest]} ]]; then
                __koi_dep_help_label=-${__koi_dep_help_shorts[$__koi_dep_help_dest]}
            fi
            __koi_dep_help_list+="${__koi_dep_help_list:+ and }$__koi_dep_help_label"
        done

        koi::internal::wrap "$__koi_dep_help_text requires $__koi_dep_help_list" '  ' '  '
    done
}

# Print the built-in help command's own menu. Lists verbose
# help only when available in the current context.
# Usage: koi::internal::print_help_command PREFIX ROOT PATH
#   PREFIX  parser-local spec prefix containing effective help metadata
#   ROOT    1 for root command usage, otherwise 0
#   PATH    CLI command path, or empty at the root
koi::internal::print_help_command() {
    local -n __koi_builtin_meta="${1}_meta"
    local __koi_builtin_root=$2 __koi_builtin_path=$3
    local __koi_builtin_width=10
    if (( __koi_builtin_root && __koi_builtin_meta[verbose] )); then
        __koi_builtin_width=13
    fi

    koi::internal::wrap 'Show help for the containing command.' '' ''
    printf '\nUsage: %s' "${__koi_builtin_meta[name]}"
    if [[ -n $__koi_builtin_path ]]; then
        printf ' %s' "$__koi_builtin_path"
    fi

    printf ' help [-h]'
    if (( __koi_builtin_root && __koi_builtin_meta[verbose] )); then
        printf ' [-v]'
    fi

    printf '\n\nOptions:\n'
    local __koi_builtin_indent __koi_builtin_first
    printf -v __koi_builtin_indent '%*s' "$((__koi_builtin_width + 4))" ''
    printf -v __koi_builtin_first '  %-*s  ' "$__koi_builtin_width" '-h, --help'
    koi::internal::wrap 'Show this help command menu' "$__koi_builtin_first" "$__koi_builtin_indent"
    if (( __koi_builtin_root && __koi_builtin_meta[verbose] )); then
        printf -v __koi_builtin_first '  %-*s  ' "$__koi_builtin_width" '-v, --verbose'
        koi::internal::wrap 'Show complete command documentation' "$__koi_builtin_first" "$__koi_builtin_indent"
    fi
}

# Print help for a consumed spec and its immediate children
# Usage: koi::internal::print_help PREFIX ROOT PATH
#   PREFIX  parser-local spec prefix
#   ROOT    1 for root command usage, otherwise 0
#   PATH    CLI command path, or empty for direct calls
koi::internal::print_help() {
    local __koi_help_prefix=$1 __koi_help_root=$2 __koi_help_path=$3
    local -n __koi_commands="${__koi_help_prefix}_commands"
    local -n __koi_help_meta="${__koi_help_prefix}_meta"
    local -n __koi_args="${__koi_help_prefix}_args"
    local -n __koi_arg_shorts="${__koi_help_prefix}_arg_shorts"
    local -n __koi_arg_longs="${__koi_help_prefix}_arg_longs"
    local -n __koi_arg_kinds="${__koi_help_prefix}_arg_kinds"
    local -n __koi_arg_cardinalities="${__koi_help_prefix}_arg_cardinalities"
    local -n __koi_arg_descriptions="${__koi_help_prefix}_arg_descriptions"
    local -n __koi_arg_requireds="${__koi_help_prefix}_arg_requireds"
    local -n __koi_arg_defaults="${__koi_help_prefix}_arg_defaults"
    local -n __koi_arg_display_names="${__koi_help_prefix}_arg_display_names"
    local __koi_help_dest __koi_help_spelling __koi_help_usage __koi_help_width
    local __koi_help_value __koi_help_description __koi_help_indent
    local -a __koi_help_labels=('-h, --help')
    __koi_help_width=${#__koi_help_labels[0]}
    local __koi_help_index=1 __koi_help_positional_section=0
    local -a __koi_help_order=()
    local -n __koi_help_groups="${1}_arg_groups"
    local -A __koi_help_groups_printed=()
    local __koi_help_group

    # show flags and options first while preserving their declaration order
    for __koi_help_dest in "${__koi_args[@]}"; do
        if [[ ${__koi_arg_kinds[$__koi_help_dest]} != positional ]]; then
            __koi_help_order+=("$__koi_help_dest")
        fi
    done

    # append positionals in the order their values are consumed
    for __koi_help_dest in "${__koi_args[@]}"; do
        if [[ ${__koi_arg_kinds[$__koi_help_dest]} == positional ]]; then
            __koi_help_order+=("$__koi_help_dest")
        fi
    done

    if [[ -n ${__koi_help_meta[description]-} ]]; then
        koi::internal::wrap "${__koi_help_meta[description]}" '' ''
        printf '\n'
    fi
    printf 'Usage: %s' "${__koi_help_meta[name]}"
    if [[ -n $__koi_help_path ]]; then
        printf ' %s' "$__koi_help_path"
    fi
    printf ' [-h]'

    for __koi_help_dest in "${__koi_help_order[@]}"; do
        # prefer short spelling in usage, fall back to long if absent
        if [[ -n ${__koi_arg_shorts[$__koi_help_dest]} ]]; then
            __koi_help_usage=-${__koi_arg_shorts[$__koi_help_dest]}
        else
            __koi_help_usage=--${__koi_arg_longs[$__koi_help_dest]}
        fi

        # uppercase the display name, falling back to long spelling then destination
        __koi_help_value=${__koi_arg_display_names[$__koi_help_dest]:-${__koi_arg_longs[$__koi_help_dest]:-$__koi_help_dest}}
        __koi_help_value=${__koi_help_value^^}
        if [[ ${__koi_arg_kinds[$__koi_help_dest]} == positional ]]; then
            __koi_help_usage=$__koi_help_value
        elif [[ ${__koi_arg_kinds[$__koi_help_dest]} == option ]]; then
            __koi_help_usage+=" $__koi_help_value"
        fi

        # mark positional arrays with ellipses in both usage and detailed labels
        if [[ ${__koi_arg_cardinalities[$__koi_help_dest]} == array && ${__koi_arg_kinds[$__koi_help_dest]} == positional ]]; then
            __koi_help_value+='...'
            __koi_help_usage=$__koi_help_value
        fi

        # replace grouped members once, keeping detailed argument rows below
        if [[ ${__koi_help_groups[$__koi_help_dest]+present} ]]; then
            __koi_help_group=${__koi_help_groups[$__koi_help_dest]}
            if [[ ! ${__koi_help_groups_printed[$__koi_help_group]+present} ]]; then
                printf ' '
                koi::internal::print_group_usage "$1" "$__koi_help_group"
                __koi_help_groups_printed[$__koi_help_group]=1
            fi
        else
            # bracket optional arguments and leave required arguments unbracketed
            if [[ ${__koi_arg_requireds[$__koi_help_dest]} == 1 ]]; then
                printf ' %s' "$__koi_help_usage"
            else
                printf ' [%s]' "$__koi_help_usage"
            fi

            # repeat the full option-value unit since each occurrence consumes one value
            if [[ ${__koi_arg_cardinalities[$__koi_help_dest]} == array && ${__koi_arg_kinds[$__koi_help_dest]} == option ]]; then
                if [[ ${__koi_arg_requireds[$__koi_help_dest]} == 1 ]]; then
                    printf ' [%s]...' "$__koi_help_usage"
                else
                    printf '...'
                fi
            fi

        fi

        # start the options-table label with the short spelling if present
        __koi_help_spelling=''
        if [[ -n ${__koi_arg_shorts[$__koi_help_dest]} ]]; then
            __koi_help_spelling=-${__koi_arg_shorts[$__koi_help_dest]}
        fi

        # append the long spelling, separating aliases with a comma
        if [[ -n ${__koi_arg_longs[$__koi_help_dest]} ]]; then
            if [[ -n $__koi_help_spelling ]]; then
                __koi_help_spelling+=', '
            fi
            __koi_help_spelling+=--${__koi_arg_longs[$__koi_help_dest]}
        fi

        # append a value label for options but not flags
        if [[ ${__koi_arg_kinds[$__koi_help_dest]} == positional ]]; then
            __koi_help_spelling=$__koi_help_value
        elif [[ ${__koi_arg_kinds[$__koi_help_dest]} == option ]]; then
            __koi_help_spelling+=" $__koi_help_value"
        fi

        # save the label and track the widest row for description alignment
        __koi_help_labels+=("$__koi_help_spelling")
        if (( ${#__koi_help_spelling} > __koi_help_width )); then
            __koi_help_width=${#__koi_help_spelling}
        fi
    done

    if (( ${#__koi_commands[@]} )); then
        printf ' COMMAND'
    fi

    printf -v __koi_help_indent '%*s' "$((__koi_help_width + 4))" ''
    if (( ${#__koi_commands[@]} || __koi_help_meta[builtin] )); then
        koi::internal::print_commands "$__koi_help_prefix"
        printf '\nOptions:\n'
    else
        printf '\n\nOptions:\n'
    fi

    printf '  %-*s  %s\n' "$__koi_help_width" "${__koi_help_labels[0]}" 'Show this help'
    for __koi_help_dest in "${__koi_help_order[@]}"; do
        if [[ ${__koi_arg_kinds[$__koi_help_dest]} == positional ]] && (( ! __koi_help_positional_section )); then
            printf '\nPositionals:\n'
            __koi_help_positional_section=1
        fi

        __koi_help_description=${__koi_arg_descriptions[$__koi_help_dest]}
        if [[ ${__koi_arg_requireds[$__koi_help_dest]} == 1 ]]; then
            __koi_help_description+=' (required)'
        fi

        if [[ ${__koi_arg_defaults[$__koi_help_dest]+present} ]]; then
            __koi_help_description+=" (default: ${__koi_arg_defaults[$__koi_help_dest]})"
        fi

        local __koi_help_first
        printf -v __koi_help_first '  %-*s  ' "$__koi_help_width" "${__koi_help_labels[$__koi_help_index]}"
        koi::internal::wrap "$__koi_help_description" "$__koi_help_first" "$__koi_help_indent"
        __koi_help_index=$((__koi_help_index + 1))
    done

    koi::internal::print_dependencies "$1"

    if (( __koi_help_root && __koi_help_meta[hints] )) &&
        (( __koi_help_meta[verbose] || ${#__koi_commands[@]} )); then
        printf '\nHints:\n'
        if (( __koi_help_meta[verbose] )); then
            printf '  %s help --verbose    Show complete command documentation\n' "${__koi_help_meta[name]}"
        fi
        if (( ${#__koi_commands[@]} )); then
            printf '  %s COMMAND --help    Show individual command documentation\n' "${__koi_help_meta[name]}"
        fi
    fi

    if [[ -n ${__koi_help_meta[epilog]-} ]]; then
        printf '\n'
        koi::internal::wrap "${__koi_help_meta[epilog]}" '' ''
    fi
}

# Accept a string containing at least one character
# Usage: koi::internal::validator::nonempty VALUE
#   VALUE  literal string; whitespace counts (returns 0 accepted, 1 rejected)
koi::internal::validator::nonempty() {
    [[ -n $1 ]]
}

# Accept lexical ASCII decimal integers without arithmetic evaluation
# Usage: koi::internal::validator::integer VALUE
#   VALUE  optional sign followed by digits (returns 0 accepted, 1 rejected)
koi::internal::validator::integer() {
    [[ $1 =~ ^[+-]?[0123456789]+$ ]]
}

# Accept an existing regular file, following symlinks
# Usage: koi::internal::validator::file VALUE
#   VALUE  path checked using Bash -f (returns 0 accepted, 1 rejected)
koi::internal::validator::file() {
    [[ -f $1 ]]
}

# Accept an existing directory, following symlinks
# Usage: koi::internal::validator::directory VALUE
#   VALUE  path checked using Bash -d (returns 0 accepted, 1 rejected)
koi::internal::validator::directory() {
    [[ -d $1 ]]
}

# Run a destination's ordered predicates before assignment
# Usage: koi::internal::validate_value PREFIX API DEST VALUE DEFAULT
#   PREFIX   consumed spec holding validator arrays
#   API      active parser API for author errors
#   DEST     destination name
#   VALUE    one literal effective value
#   DEFAULT  1 for an omitted argument's explicit default, otherwise 0
# Returns 2 at the first rejection or operational failure, otherwise 0
koi::internal::validate_value() {
    local -n __koi_check_dests="${1}_validator_dests" __koi_check_selectors="${1}_validator_selectors"
    local -n __koi_check_functions="${1}_validator_functions" __koi_check_messages="${1}_validator_messages"
    local __koi_check_index __koi_check_function __koi_check_reason __koi_check_status
    for __koi_check_index in "${!__koi_check_dests[@]}"; do
        if [[ ${__koi_check_dests[$__koi_check_index]} != "$3" ]]; then
            continue
        fi

        __koi_check_function=${__koi_check_functions[$__koi_check_index]}
        case ${__koi_check_selectors[$__koi_check_index]} in
            nonempty)
                __koi_check_function=koi::internal::validator::nonempty
                __koi_check_reason='must not be empty'
                ;;
            integer)
                __koi_check_function=koi::internal::validator::integer
                __koi_check_reason='must be an integer'
                ;;
            file)
                __koi_check_function=koi::internal::validator::file
                __koi_check_reason='must be an existing file'
                ;;
            directory)
                __koi_check_function=koi::internal::validator::directory
                __koi_check_reason='must be an existing directory'
                ;;
            custom)
                __koi_check_reason=${__koi_check_messages[$__koi_check_index]:-validation failed}
                ;;
        esac

        if "$__koi_check_function" "$4"; then
            continue
        else
            __koi_check_status=$?
        fi

        if (( __koi_check_status > 1 )); then
            koi::internal::author_error "$2" "argument '$3': callback '$__koi_check_function' failed with status $__koi_check_status"
        elif [[ $5 == 1 ]]; then
            koi::internal::author_error "$2" "invalid default for argument '$3': $__koi_check_reason"
        else
            koi::internal::user_error "invalid argument '$3': $__koi_check_reason"
        fi

        return 2
    done

    return 0
}
