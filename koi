#!/usr/bin/env bash

# Namerefs target typed buffers; ShellCheck cannot infer their array types.
# shellcheck disable=SC2004,SC2178

# actual init logic starts in the bottom CONTROL FLOW section

# ------------------ PUBLIC API ------------------

# Configure script-wide help metadata before consuming root registration
# Usage: __koiconfig KEY VALUE
#   KEY    name, description, or help-width (positive integer, at most nine digits, default 100)
#   VALUE  nonempty setting value (name defaults to the script basename)
# Call outside any function, after sourcing koi and before __koirun or root __parseargs.
# Returns 2 and invalidates registration on invalid or repeated settings
__koiconfig() {
    local __koi_buffer
    __koi_select_registration_buffer __koi_buffer || return 2
    if [[ $__koi_buffer != __koi_root ]]; then
        __koi_spec_error "$__koi_buffer" '__koiconfig: call outside any function, after sourcing koi and before __koirun or script-level __parseargs'
        return 2
    fi

    if (( $# != 2 )) || [[ -z $2 ]]; then
        __koi_spec_error "$__koi_buffer" '__koiconfig: KEY and nonempty VALUE required'
        return 2
    fi

    case $1 in
        name|description)
            ;;
        help-width)
            if [[ ! $2 =~ ^[0-9]+$ || ${#2} -gt 9 ]] || (( 10#$2 == 0 )); then
                __koi_spec_error "$__koi_buffer" '__koiconfig: help-width must be a positive integer'
                return 2
            fi
            ;;
        *)
            __koi_spec_error "$__koi_buffer" "__koiconfig: unknown key: $1"
            return 2
            ;;
    esac

    if [[ ${__koi_config[$1]+present} ]]; then
        __koi_spec_error "$__koi_buffer" "__koiconfig: repeated key: $1"
        return 2
    fi

    __koi_config[$1]=$2
}

# Describe a directly invoked parsing function
# Usage: __adddescription TEXT
#   TEXT  nonempty fallback description, routed command descriptions (i.e. from
#         __addcommand -d) take precedence
# Returns 2 and invalidates registration on invalid scope, arguments, or duplicate descriptions
__adddescription() {
    local __koi_buffer
    __koi_select_registration_buffer __koi_buffer || return 2
    local -n __koi_description_meta="${__koi_buffer}_meta"
    if [[ $__koi_buffer == __koi_root ]]; then
        __koi_spec_error "$__koi_buffer" '__adddescription: call inside a function; use __koiconfig description TEXT for the script description'
        return 2
    fi

    if (( $# != 1 )) || [[ -z $1 ]]; then
        __koi_spec_error "$__koi_buffer" '__adddescription: expected exactly one nonempty description'
        return 2
    fi

    if [[ ${__koi_description_meta[description]+present} ]]; then
        __koi_spec_error "$__koi_buffer" '__adddescription: repeated description'
        return 2
    fi

    __koi_description_meta[description]=$1
}

# Register a command with koi. The command will be registered as an immediate
# child in the current uninterrupted registration block. In functions, you
# must close the registration block with __parseargs. In the root context,
# you must close the registration with __koirun.
# Usage: __addcommand NAME -f HANDLER -d DESCRIPTION
#   NAME               the name of the command
#   -f, --function     the command's associated handler function
#   -d, --description  the description of the command
# Returns 2 on invalid declarations
__addcommand() {
    local __koi_buffer
    __koi_select_registration_buffer __koi_buffer || return $?
    local -n __koi_commands="${__koi_buffer}_commands"
    local -n __koi_handlers="${__koi_buffer}_handlers"
    local -n __koi_descriptions="${__koi_buffer}_descriptions"

    local __koi_name=${1-} __koi_handler='' __koi_description=''
    local __koi_seen_function=0 __koi_seen_description=0

    if (( $# == 0 )); then
        __koi_spec_error "$__koi_buffer" '__addcommand: command name required'
        return 2
    fi
    shift

    if [[ ! $__koi_name =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]]; then
        __koi_spec_error "$__koi_buffer" "__addcommand: invalid command name: '$__koi_name'"
        return 2
    fi

    while (( $# )); do
        case $1 in
            -f|--function)
                if (( __koi_seen_function || $# < 2 )); then
                    __koi_spec_error "$__koi_buffer" '__addcommand: invalid --function'
                    return 2
                fi
                __koi_seen_function=1
                __koi_handler=$2
                ;;
            -d|--description)
                if (( __koi_seen_description || $# < 2 )); then
                    __koi_spec_error "$__koi_buffer" '__addcommand: invalid --description'
                    return 2
                fi
                __koi_seen_description=1
                __koi_description=$2
                ;;
            *)
                __koi_spec_error "$__koi_buffer" "__addcommand: unknown registration parameter: $1"
                return 2
                ;;
        esac
        shift 2
    done

    if [[ ! $__koi_handler =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]]; then
        __koi_spec_error "$__koi_buffer" '__addcommand: handler identifier required'
        return 2
    fi

    if [[ -z $__koi_description ]]; then
        __koi_spec_error "$__koi_buffer" '__addcommand: nonempty description required'
        return 2
    fi

    if [[ ${__koi_handlers[$__koi_name]+present} ]]; then
        __koi_spec_error "$__koi_buffer" "duplicate command: $__koi_name"
        return 2
    fi

    __koi_commands+=("$__koi_name")
    __koi_handlers[$__koi_name]=$__koi_handler
    __koi_descriptions[$__koi_name]=$__koi_description
}

# Register a parsable argument with koi. The argument will be registered with the
# current uninterrupted registration block. In functions, you must close the
# registration block with __parseargs. In the root context, you must close the
# registration with __koirun, or __parseargs called outside any function.
# Usage: __addarg DEST (-f|-o|-p) -d DESCRIPTION [-s SHORT || -l LONG] [-r] [-D DEFAULT] [-n DISPLAY_NAME]
# Flags/options require a short or long spelling; positionals reject both.
#   DEST                     the Bash destination variable name
#   -f, --flag               register a boolean flag (e.g. '-f')
#   -o, --option             register an option that consumes one value (e.g. '-o value')
#   -p, --positional         consume one positional value, in declaration order
#   -s, --short              short spelling without its dash (one letter)
#   -l, --long               long spelling without its dashes
#   -d, --description        nonempty argument description
#   -r, --required           require explicit presence when parsing
#   -D, --default DEFAULT    default for an optional option or positional (empty allowed)
#   -n, --display-name NAME  option or positional value label
# Returns 2 on invalid declarations
__addarg() {
    local __koi_buffer
    __koi_select_registration_buffer __koi_buffer || return $?
    local -n __koi_args="${__koi_buffer}_args"
    local -n __koi_arg_shorts="${__koi_buffer}_arg_shorts"
    local -n __koi_arg_longs="${__koi_buffer}_arg_longs"
    local -n __koi_arg_kinds="${__koi_buffer}_arg_kinds"
    local -n __koi_arg_descriptions="${__koi_buffer}_arg_descriptions"
    local -n __koi_arg_requireds="${__koi_buffer}_arg_requireds"
    local -n __koi_arg_defaults="${__koi_buffer}_arg_defaults"
    local -n __koi_arg_display_names="${__koi_buffer}_arg_display_names"

    local __koi_dest=${1-} __koi_parameter __koi_value
    local -A __koi_values=([short]='' [long]='' [kind]='' [description]='' [required]=0)
    local -A __koi_seen=()

    if (( $# == 0 )); then
        __koi_spec_error "$__koi_buffer" '__addarg: destination required'
        return 2
    fi
    shift

    __koi_validate_arg_destination "$__koi_buffer" "$__koi_dest" || return $?

    while (( $# )); do
        case $1 in
            -f|--flag)
                __koi_parameter=kind
                __koi_value=flag
                ;;
            -o|--option)
                __koi_parameter=kind
                __koi_value=option
                ;;
            -p|--positional)
                __koi_parameter=kind
                __koi_value=positional
                ;;
            -r|--required)
                __koi_parameter=required
                __koi_value=1
                ;;
            -s|--short)
                __koi_parameter=short
                ;;
            -l|--long)
                __koi_parameter=long
                ;;
            -d|--description)
                __koi_parameter=description
                ;;
            -D|--default)
                __koi_parameter=default
                ;;
            -n|--display-name)
                __koi_parameter=display_name
                ;;
            *)
                __koi_spec_error "$__koi_buffer" "__addarg: unknown declaration parameter: $1"
                return 2
                ;;
        esac

        if [[ ${__koi_seen[$__koi_parameter]+present} ]]; then
            __koi_spec_error "$__koi_buffer" "__addarg: repeated or conflicting parameter: $__koi_parameter"
            return 2
        fi

        case $__koi_parameter in
            kind|required)
                shift
                ;;
            *)
                if (( $# < 2 )); then
                    __koi_spec_error "$__koi_buffer" "__addarg: missing value for $1"
                    return 2
                fi
                __koi_value=$2
                shift 2
                ;;
        esac

        __koi_seen[$__koi_parameter]=1
        __koi_values[$__koi_parameter]=$__koi_value
    done

    __koi_validate_arg_spec "$__koi_buffer" "$__koi_dest" __koi_values __koi_seen || return $?

    __koi_args+=("$__koi_dest")
    __koi_arg_shorts[$__koi_dest]=${__koi_values[short]}
    __koi_arg_longs[$__koi_dest]=${__koi_values[long]}
    __koi_arg_kinds[$__koi_dest]=${__koi_values[kind]}
    __koi_arg_descriptions[$__koi_dest]=${__koi_values[description]}
    __koi_arg_requireds[$__koi_dest]=${__koi_values[required]}
    if [[ ${__koi_seen[display_name]+present} ]]; then
        __koi_arg_display_names[$__koi_dest]=${__koi_values[display_name]}
    fi
    if [[ ${__koi_seen[default]+present} ]]; then
        __koi_arg_defaults[$__koi_dest]=${__koi_values[default]}
    fi
    return 0
}

# Consume argument registration and parse arguments, assign literal scalar
# values, and optionally route a child command. Closes the current
# uninterrupted registration block. $koi_status is the owning function's
# return status and is used for exit/return control flow.
# Usage: __parseargs [--koi-error-on-duplicates] [--koi-inspect MODE] "$@" || return "$koi_status"
# Internal usage: __parseargs --koi-inspect spec || return "$koi_status"
#   --koi-error-on-duplicates  reject repeated occurrences of a destination
#   --koi-inspect MODE         run the registered command handler functions
#                              in inspect mode (available modes: 'spec' -
#                              internal-only spec collection)
#   $@                         the script arguments to parse
# Returns 0 to continue, 1 to stop after help/dispatch, or 2 on error
__parseargs() {
    local __koi_buffer __koi_path='' __koi_result __koi_collect_matches=0
    koi_status=2
    __koi_select_registration_buffer __koi_buffer || return 2
    local -a __koi_parsed_commands=()
    local -A __koi_parsed_handlers=()
    local -A __koi_parsed_descriptions=()
    local -a __koi_parsed_args=()
    local -A __koi_parsed_arg_shorts=()
    local -A __koi_parsed_arg_longs=()
    local -A __koi_parsed_arg_kinds=()
    local -A __koi_parsed_arg_descriptions=()
    local -A __koi_parsed_arg_requireds=()
    local -A __koi_parsed_arg_defaults=()
    local -A __koi_parsed_arg_display_names=()
    local -A __koi_parsed_meta=()
    local -i __koi_parsed_spec_valid=1

    # move registration into parser-local storage before validation or nested dispatch
    __koi_take_spec "$__koi_buffer" __koi_parsed
    if [[ $__koi_buffer == __koi_root ]]; then
        __koi_root_used=1
    fi

    # distinguish script-level parsing from a function's registration block
    local __koi_root_context=0
    if [[ $__koi_buffer == __koi_root ]]; then
        __koi_root_context=1
    fi

    # attach script settings and default help metadata to the consumed spec
    __koi_prepare_spec __koi_parsed "$__koi_root_context"
    # match the requested invocation so helpers and recursion cannot capture its collector
    if [[ ${FUNCNAME[1]-} == "${__koi_inspection_handler-}" &&
          ${#FUNCNAME[@]} == "${__koi_inspection_depth-}" ]]; then
        __koi_collect_matches=1
    fi

    # apply the CLI path only to the handler invocation selected by routing
    if [[ ${FUNCNAME[1]-} == "${__koi_route_handler-}" &&
          ${#FUNCNAME[@]} == "${__koi_route_depth-}" ]]; then
        __koi_path=${__koi_route_path-}
        __koi_parsed_meta[description]=${__koi_route_description-}
        __koi_parsed_meta[builtin]=${__koi_route_help:-0}
        __koi_parsed_meta[verbose]=${__koi_route_verbose:-0}
    fi

    __koi_parsed_meta[path]=$__koi_path

    # parse the consumed spec and capture any selected child command
    local __koi_selected_handler='' __koi_selected_command=''
    local -a __koi_remaining=()
    if __koi_parse_spec __koi_parsed 0 "$__koi_path" '' 0 \
        __koi_selected_handler __koi_selected_command __koi_remaining "$@"; then
        __koi_result=0
    else
        __koi_result=$?
    fi

    # retain the child's description and help policy before discarding the spec
    local __koi_selected_description=''
    if [[ -n $__koi_selected_command ]]; then
        __koi_selected_description=${__koi_parsed_descriptions[$__koi_selected_command]-}
    fi
    local __koi_selected_help=${__koi_parsed_meta[builtin]}
    local __koi_selected_verbose=${__koi_parsed_meta[verbose]}

    # release declaration metadata before invoking the selected child
    __koi_clear_spec __koi_parsed
    if (( __koi_result == 3 )); then
        local __koi_route_description=$__koi_selected_description
        local __koi_route_help=$__koi_selected_help __koi_route_verbose=$__koi_selected_verbose
        local __koi_route_handler=$__koi_selected_handler
        local __koi_route_depth=$((${#FUNCNAME[@]} + 2))
        local __koi_route_path=${__koi_path:+$__koi_path }$__koi_selected_command
        if "$__koi_selected_handler" "${__koi_remaining[@]}"; then
            __koi_result=0
        else
            __koi_result=$?
        fi
        koi_status=$__koi_result
        return 1
    fi

    # publish success for help while keeping the caller's return guard active
    if (( __koi_result == 1 )); then
        koi_status=0
    else
        koi_status=$__koi_result
    fi

    return "$__koi_result"
}

# Consume root registration and route once per library initialization.
# Expected to be called once per script, repeated calls will error.
# Usage: __koirun [--koi-zero-argument-message MESSAGE] [--koi-enable-help-on-unknown-commands] [--koi-disable-help-subcommand] [--koi-enable-verbose-help] [--koi-enable-help-hints] [--koi-inspect MODE] "$@"
#   --koi-zero-argument-message MESSAGE   error text override when no command is given
#                                         (default is help menu)
#   --koi-enable-help-on-unknown-commands allow unknown commands with standalone help
#   --koi-disable-help-subcommand         allow custom help instead of built-in help
#   --koi-enable-verbose-help             enable root help --verbose
#   --koi-enable-help-hints               append available hints to ordinary root help
#   --koi-inspect MODE                    run the registered command handler functions
#                                         in inspect mode (available modes: 'spec' -
#                                         internal-only spec collection)
#   $@                                    root options, positionals, or command and
#                                         child arguments
# Returns the handler's status, 0 for help/terminal parsing, or 2 on error
__koirun() {
    if (( __koi_root_used )); then
        __koi_run_error '__koirun: call only once per script; __koirun or script-scope __parseargs has already been called'
        return 2
    fi
    __koi_root_used=1
    local -a __koi_parsed_commands=()
    local -A __koi_parsed_handlers=()
    local -A __koi_parsed_descriptions=()
    local -a __koi_parsed_args=()
    local -A __koi_parsed_arg_shorts=()
    local -A __koi_parsed_arg_longs=()
    local -A __koi_parsed_arg_kinds=()
    local -A __koi_parsed_arg_descriptions=()
    local -A __koi_parsed_arg_requireds=()
    local -A __koi_parsed_arg_defaults=()
    local -A __koi_parsed_arg_display_names=()
    local -A __koi_parsed_meta=()
    local -i __koi_parsed_spec_valid=1
    __koi_take_spec __koi_root __koi_parsed
    if (( ! __koi_parsed_spec_valid )); then
        return 2
    fi
    local __koi_run_message='' __koi_run_message_set=0 __koi_run_unknown_help=0
    local __koi_run_help=1 __koi_run_verbose=0 __koi_run_hints=0 __koi_collect_matches=0
    local -A __koi_run_seen=()
    # accept a root collector only at the runner invocation it explicitly targets
    if [[ ${__koi_inspection_handler-} == __koirun &&
          ${#FUNCNAME[@]} == "${__koi_inspection_depth-}" ]]; then
        __koi_collect_matches=1
    fi
    # handle admin flags first
    local __koi_result __koi_selected_handler='' __koi_selected_command=''
    local -a __koi_remaining=()
    while (( $# )); do
        case $1 in
            --koi-disable-help-subcommand|--koi-enable-verbose-help|--koi-enable-help-hints)
                if [[ ${__koi_run_seen[$1]+present} ]]; then
                    __koi_run_error "repeated $1"
                    return 2
                fi
                __koi_run_seen[$1]=1
                case $1 in
                    --koi-disable-help-subcommand)
                        __koi_run_help=0
                        ;;
                    --koi-enable-verbose-help)
                        __koi_run_verbose=1
                        ;;
                    --koi-enable-help-hints)
                        __koi_run_hints=1
                        ;;
                esac
                shift
                ;;
            --koi-zero-argument-message)
                if (( __koi_run_message_set || $# < 2 )) || [[ -z $2 ]]; then
                    __koi_run_error 'invalid or repeated --koi-zero-argument-message'
                    return 2
                fi
                __koi_run_message=$2
                __koi_run_message_set=1
                shift 2
                ;;
            --koi-enable-help-on-unknown-commands)
                if (( __koi_run_unknown_help )); then
                    __koi_run_error 'repeated --koi-enable-help-on-unknown-commands'
                    return 2
                fi
                __koi_run_unknown_help=1
                shift
                ;;
            *)
                break
                ;;
        esac
    done

    if (( __koi_run_verbose && ! __koi_run_help )); then
        __koi_run_error '--koi-enable-verbose-help requires the built-in help subcommand'
        return 2
    fi
    __koi_prepare_spec __koi_parsed 1
    __koi_parsed_meta[builtin]=$__koi_run_help
    __koi_parsed_meta[verbose]=$__koi_run_verbose
    __koi_parsed_meta[hints]=$__koi_run_hints
    __koi_parsed_meta[runner]=1

    # parse root options and prepare command dispatch
    if __koi_parse_spec __koi_parsed 1 '' "$__koi_run_message" "$__koi_run_unknown_help" \
        __koi_selected_handler __koi_selected_command __koi_remaining "$@"; then
        __koi_result=0
    else
        __koi_result=$?
    fi

    # retain the selected command's description before discarding root metadata
    local __koi_selected_description=''
    if [[ -n $__koi_selected_command ]]; then
        __koi_selected_description=${__koi_parsed_descriptions[$__koi_selected_command]-}
    fi

    # discard root metadata and translate help into a successful runner return
    __koi_clear_spec __koi_parsed
    if (( __koi_result != 3 )); then
        if (( __koi_result == 1 )); then
            return 0
        fi
        return "$__koi_result"
    fi

    local __koi_route_description=$__koi_selected_description
    local __koi_route_help=$__koi_run_help __koi_route_verbose=$__koi_run_verbose
    local __koi_route_handler=$__koi_selected_handler
    local __koi_route_depth=$((${#FUNCNAME[@]} + 2))
    local __koi_route_path=$__koi_selected_command
    # leave dispatch unconditional so root handlers keep normal errexit behavior
    "$__koi_selected_handler" "${__koi_remaining[@]}"
}

# ------------------ INTERNAL ------------------

# Complete consumed metadata with script settings and direct-call defaults
# Usage: __koi_prepare_spec PREFIX ROOT
#   PREFIX  consumed spec prefix
#   ROOT    1 for script-scope registration, otherwise 0
# ShellCheck cannot infer associative keys through this nameref
# shellcheck disable=SC2154
__koi_prepare_spec() {
    local -n __koi_prepare_meta="${1}_meta"
    __koi_prepare_meta[name]=${__koi_config[name]:-${0##*/}}
    __koi_prepare_meta[help-width]=${__koi_config[help-width]:-100}
    __koi_prepare_meta[root]=$2
    __koi_prepare_meta[path]=''
    __koi_prepare_meta[builtin]=0
    __koi_prepare_meta[verbose]=0
    __koi_prepare_meta[hints]=0
    __koi_prepare_meta[runner]=0
    if (( $2 )); then
        __koi_prepare_meta[description]=${__koi_config[description]-}
    fi
}

# Wrap description text, preserving explicit line breaks and unbroken words. Uses
# configured help-width, prints literal values without interpreting escapes.
# Usage: __koi_wrap TEXT FIRST_PREFIX CONTINUATION_PREFIX
#   TEXT                 description to print, split on spaces and tabs for wrapping
#   FIRST_PREFIX         prefix for the first output line
#   CONTINUATION_PREFIX  indentation for subsequent lines
__koi_wrap() {
    local __koi_wrap_text=$1 __koi_wrap_prefix=$2 __koi_wrap_indent=$3
    local __koi_wrap_line __koi_wrap_word __koi_wrap_output
    local __koi_wrap_width=${__koi_config[help-width]:-100}
    __koi_wrap_width=$((10#$__koi_wrap_width))
    local -a __koi_wrap_words=()
    while IFS= read -r __koi_wrap_line; do
        IFS=$' \t' read -r -a __koi_wrap_words <<< "$__koi_wrap_line"
        __koi_wrap_output=$__koi_wrap_prefix
        for __koi_wrap_word in "${__koi_wrap_words[@]}"; do
            if [[ $__koi_wrap_output != "$__koi_wrap_prefix" ]]; then
                if (( ${#__koi_wrap_output} + 1 + ${#__koi_wrap_word} > __koi_wrap_width )); then
                    printf '%s\n' "$__koi_wrap_output"
                    __koi_wrap_prefix=$__koi_wrap_indent
                    __koi_wrap_output=$__koi_wrap_prefix
                else
                    __koi_wrap_output+=' '
                fi
            fi
            __koi_wrap_output+=$__koi_wrap_word
        done
        printf '%s\n' "$__koi_wrap_output"
        __koi_wrap_prefix=$__koi_wrap_indent
    done <<< "$__koi_wrap_text"
}

# Render a collected context, then inspect its application children in order
# Usage: __koi_walk_spec PREFIX
#   PREFIX  consumed spec containing effective metadata and ordered children
# Returns 2 if a descendant cannot be inspected
__koi_walk_spec() {
    local __koi_tree_prefix=$1
    local -n __koi_tree_commands="${__koi_tree_prefix}_commands"
    local -n __koi_tree_handlers="${__koi_tree_prefix}_handlers"
    local -n __koi_tree_descriptions="${__koi_tree_prefix}_descriptions"
    local -n __koi_tree_meta="${__koi_tree_prefix}_meta"
    __koi_print_help "$__koi_tree_prefix" "${__koi_tree_meta[runner]}" "${__koi_tree_meta[path]}"
    local __koi_route_help=${__koi_tree_meta[builtin]} __koi_route_verbose=${__koi_tree_meta[verbose]}
    local __koi_tree_child
    for __koi_tree_child in "${__koi_tree_commands[@]}"; do
        __koi_visit_command "${__koi_tree_handlers[$__koi_tree_child]}" \
            "${__koi_tree_meta[path]:+${__koi_tree_meta[path]} }$__koi_tree_child" \
            "${__koi_tree_descriptions[$__koi_tree_child]}" || return 2
    done
    return 0
}

# Inspect one routed handler into invocation-local arrays before descending
# Usage: __koi_visit_command HANDLER PATH DESCRIPTION
#   HANDLER      registered function to invoke once with --koi-inspect spec
#   PATH         complete CLI command path
#   DESCRIPTION  selected alias description
# Returns 2 on active-ancestry recursion, handler failure, or missing collection
__koi_visit_command() {
    local __koi_visit_handler=$1 __koi_visit_path=$2 __koi_visit_description=$3
    local __koi_visit_ancestor
    for __koi_visit_ancestor in "${__koi_walk_ancestors[@]}"; do
        if [[ $__koi_visit_ancestor == "$__koi_visit_handler" ]]; then
            __koi_run_error "recursive inspection at '$__koi_visit_path' (handler '$__koi_visit_handler')"
            return 2
        fi
    done
    local -a __koi_walk_ancestors=("${__koi_walk_ancestors[@]}" "$__koi_visit_handler")
    local -a __koi_visit_spec_commands=()
    local -A __koi_visit_spec_handlers=()
    local -A __koi_visit_spec_descriptions=()
    local -a __koi_visit_spec_args=()
    local -A __koi_visit_spec_arg_shorts=()
    local -A __koi_visit_spec_arg_longs=()
    local -A __koi_visit_spec_arg_kinds=()
    local -A __koi_visit_spec_arg_descriptions=()
    local -A __koi_visit_spec_arg_requireds=()
    local -A __koi_visit_spec_arg_defaults=()
    local -A __koi_visit_spec_arg_display_names=()
    local -A __koi_visit_spec_meta=()
    local -i __koi_visit_spec_spec_valid=1
    local __koi_inspection_sink=__koi_visit_spec __koi_inspection_received=0
    local __koi_inspection_handler=$__koi_visit_handler
    local __koi_inspection_depth=$((${#FUNCNAME[@]} + 2))
    local __koi_route_handler=$__koi_visit_handler __koi_route_path=$__koi_visit_path
    local __koi_route_description=$__koi_visit_description
    local __koi_route_depth=$__koi_inspection_depth
    if "$__koi_visit_handler" --koi-inspect spec; then
        if (( ! __koi_inspection_received )); then
            __koi_clear_spec __koi_pending
            __koi_run_error "inspection at '$__koi_visit_path' did not reach __parseargs"
            return 2
        fi
    else
        __koi_clear_spec __koi_pending
        __koi_run_error "inspection failed at '$__koi_visit_path'"
        return 2
    fi
    printf '\n'
    __koi_walk_spec __koi_visit_spec
}

# Select registration storage from the public API's application caller
# Usage: __koi_select_registration_buffer OUTPUT_VAR
#   OUTPUT_VAR  receives the root or pending buffer prefix
# Returns 2 if root registration has already been consumed
__koi_select_registration_buffer() {
    local -n __koi_buffer_output=$1
    local __koi_frame
    __koi_buffer_output=__koi_root

    for ((__koi_frame=2; __koi_frame<${#FUNCNAME[@]}; __koi_frame++)); do
        case ${FUNCNAME[__koi_frame]} in
            source)
                continue
                ;;
            main)
                # Bash's script entry has no calling line, a function named main does
                if (( __koi_frame == ${#FUNCNAME[@]} - 1 && ${BASH_LINENO[__koi_frame]} == 0 )); then
                    continue
                fi
                ;;
        esac

        __koi_buffer_output=__koi_pending
        break
    done

    if [[ $__koi_buffer_output == __koi_root ]] && (( __koi_root_used )); then
        __koi_error 'root registration already consumed'
        return 2
    fi
    return 0
}

# Empty a spec and restore its registration validity
# Usage: __koi_clear_spec PREFIX
#   PREFIX  prefix of the spec's arrays and validity scalar
__koi_clear_spec() {
    local __koi_clear_field
    for __koi_clear_field in "${__koi_spec_fields[@]}"; do
        local -n __koi_clear_array="${1}_${__koi_clear_field}"
        __koi_clear_array=()
    done
    local -n __koi_clear_valid="${1}_spec_valid"
    __koi_clear_valid=1
}

# Copy a spec into already-declared typed storage without interpreting values
# Usage: __koi_copy_spec SOURCE_PREFIX TARGET_PREFIX
#   SOURCE_PREFIX  spec to read
#   TARGET_PREFIX  destination arrays and validity scalar; previous contents are cleared
__koi_copy_spec() {
    __koi_clear_spec "$2"
    local __koi_take_field __koi_take_key

    # copy fields by key to preserve array order and literal metadata values
    for __koi_take_field in "${__koi_spec_fields[@]}"; do
        local -n __koi_take_source="${1}_${__koi_take_field}"
        local -n __koi_take_target="${2}_${__koi_take_field}"
        for __koi_take_key in "${!__koi_take_source[@]}"; do
            __koi_take_target[$__koi_take_key]=${__koi_take_source[$__koi_take_key]}
        done
    done

    local -n __koi_take_source_valid="${1}_spec_valid" __koi_take_target_valid="${2}_spec_valid"
    __koi_take_target_valid=$__koi_take_source_valid
}

# Move registration into already-declared parser-local storage
# Usage: __koi_take_spec SOURCE_PREFIX TARGET_PREFIX
#   SOURCE_PREFIX  registration buffer to consume
#   TARGET_PREFIX  typed storage receiving all metadata
__koi_take_spec() {
    __koi_copy_spec "$1" "$2"
    __koi_clear_spec "$1"
}

# Parse a consumed spec and prepare dispatch without invoking business logic
# Usage: __koi_parse_spec PREFIX ROOT PATH MESSAGE UNKNOWN_HELP HANDLER_VAR COMMAND_VAR REMAINING_ARRAY "$@"
#   PREFIX           parser-local spec prefix
#   ROOT             1 for runner help/routing behavior, otherwise 0
#   PATH             selected CLI path, or empty for direct calls
#   MESSAGE          root no-command error, or empty for help
#   UNKNOWN_HELP     1 to allow root unknown-command help
#   HANDLER_VAR      receives the selected child handler
#   COMMAND_VAR      receives the selected child command name
#   REMAINING_ARRAY  receives exact arguments following the child name
#   $@               options and optional child command to parse
# Returns 0 to continue, 1 for help, 2 on error, or 3 for prepared dispatch
__koi_parse_spec() {
    local __koi_engine_prefix=$1 __koi_engine_root=$2 __koi_engine_path=$3
    local __koi_engine_message=$4 __koi_engine_unknown_help=$5
    local -n __koi_engine_handler=$6 __koi_engine_command=$7 __koi_engine_remaining=$8
    shift 8
    local -n __koi_commands="${__koi_engine_prefix}_commands"
    local -n __koi_handlers="${__koi_engine_prefix}_handlers"
    local -n __koi_args="${__koi_engine_prefix}_args"
    local -n __koi_arg_kinds="${__koi_engine_prefix}_arg_kinds"
    local -n __koi_arg_requireds="${__koi_engine_prefix}_arg_requireds"
    local -n __koi_arg_defaults="${__koi_engine_prefix}_arg_defaults"
    local -n __koi_spec_valid="${__koi_engine_prefix}_spec_valid"
    local -n __koi_engine_meta="${__koi_engine_prefix}_meta"
    local -a __koi_engine_tail=()
    local __koi_engine_child __koi_engine_token
    if (( ! __koi_spec_valid )); then
        return 2
    fi

    # validate the completed layout and resolve help availability before parsing
    __koi_finalize_spec "$__koi_engine_prefix" || return 2
    local __koi_engine_command_root=$((__koi_engine_root && ! ${__koi_engine_meta[positionals]}))

    if (( __koi_engine_meta[builtin] )) && [[ ${__koi_handlers[help]+present} ]]; then
        __koi_run_error "command 'help' conflicts with built-in help, use --koi-disable-help-subcommand"
        return 2
    fi

    # reject missing registered handlers before help or command selection
    for __koi_engine_child in "${__koi_commands[@]}"; do
        if ! declare -F -- "${__koi_handlers[$__koi_engine_child]}" >/dev/null; then
            __koi_run_error "missing handler '${__koi_handlers[$__koi_engine_child]}' for command '$__koi_engine_child'"
            return 2
        fi
    done

    if [[ ${1-} == --koi-inspect ]]; then
        if (( $# != 2 )) || [[ ${2-} != spec ]]; then
            __koi_run_error 'invalid inspection request: expected --koi-inspect spec'
            return 2
        fi
        if (( ! ${__koi_collect_matches:-0} )) || [[ -z ${__koi_inspection_sink-} ]]; then
            __koi_run_error 'standalone inspection is not supported, an internal collector is required'
            return 2
        fi
        __koi_copy_spec "$__koi_engine_prefix" "$__koi_inspection_sink"
        __koi_inspection_received=1
        return 1
    fi

    # keep scanned values and presence separate until all checks pass
    local __koi_parse_result
    local __koi_parse_dest __koi_parse_error='' __koi_parse_declaration __koi_parse_attributes
    local -A __koi_parse_values=() __koi_parse_seen=()

    # pass variable names so the scanner can fill these through namerefs
    if __koi_scan_args "$__koi_engine_prefix" __koi_parse_values __koi_parse_seen __koi_parse_error __koi_engine_tail "$__koi_engine_command_root" "$@"; then
        __koi_parse_result=0
    else
        __koi_parse_result=$?
    fi

    # trigger the caller's guard while returning success from its function
    if (( __koi_parse_result == 1 )); then
        __koi_print_help "$__koi_engine_prefix" "$__koi_engine_root" "$__koi_engine_path"
        return 1
    fi

    # report input errors only after giving help a chance to take precedence
    if [[ -n $__koi_parse_error ]]; then
        __koi_error "__parseargs: $__koi_parse_error"
        return 2
    fi

    # resolve the child command without interpreting its remaining arguments
    if (( ${#__koi_engine_tail[@]} )); then
        __koi_engine_command=${__koi_engine_tail[0]}
        __koi_engine_remaining=("${__koi_engine_tail[@]:1}")
        if [[ $__koi_engine_command == help ]] && (( __koi_engine_meta[builtin] )); then
            case ${#__koi_engine_remaining[@]} in
                0)
                    __koi_print_help "$__koi_engine_prefix" "$__koi_engine_root" "$__koi_engine_path"
                    ;;
                1)
                    case ${__koi_engine_remaining[0]} in
                        -h|--help)
                            __koi_print_help "$__koi_engine_prefix" "$__koi_engine_root" "$__koi_engine_path"
                            ;;
                        --verbose)
                            if (( ! __koi_engine_root || ! __koi_engine_meta[verbose] )); then
                                __koi_error "__parseargs: unsupported positional argument: '${__koi_engine_remaining[0]}'"
                                return 2
                            fi
                            __koi_engine_meta[hints]=0
                            local -a __koi_walk_ancestors=()
                            __koi_walk_spec "$__koi_engine_prefix" || return 2
                            ;;
                        *)
                            __koi_error "__parseargs: unsupported positional argument: '${__koi_engine_remaining[0]}'"
                            return 2
                            ;;
                    esac
                    ;;
                *)
                    __koi_run_error 'unsupported help arguments'
                    return 2
                    ;;
            esac
            return 1
        fi

        # reject unregistered commands unless the root's unknown-command help override applies
        if [[ -z $__koi_engine_command || ! ${__koi_handlers[$__koi_engine_command]+present} ]]; then
            if (( __koi_engine_root && __koi_engine_unknown_help )); then
                for __koi_engine_token in "${__koi_engine_remaining[@]}"; do
                    case $__koi_engine_token in
                        --)
                            break
                            ;;
                        -h|--help)
                            __koi_print_help "$__koi_engine_prefix" 1 "$__koi_engine_path"
                            return 1
                            ;;
                    esac
                done
            fi
            __koi_run_error "unknown command '$__koi_engine_command'"
            return 2
        fi
        __koi_engine_handler=${__koi_handlers[$__koi_engine_command]}
    elif (( __koi_engine_command_root || ${#__koi_commands[@]} )); then
        # honor the configured error message when no root command was supplied
        if (( __koi_engine_root )) && [[ -n $__koi_engine_message ]]; then
            __koi_run_error "$__koi_engine_message"
            return 2
        fi

        __koi_print_help "$__koi_engine_prefix" "$__koi_engine_root" "$__koi_engine_path"
        return 1
    fi

    # check presence and fill omitted values without touching user variables
    for __koi_parse_dest in "${__koi_args[@]}"; do
        # check if required but was not included
        if [[ ${__koi_arg_requireds[$__koi_parse_dest]} == 1 && ! ${__koi_parse_seen[$__koi_parse_dest]+present} ]]; then
            __koi_error "__parseargs: missing required argument: '$__koi_parse_dest'"
            return 2
        fi

        # determine default, if one is available
        if [[ ! ${__koi_parse_seen[$__koi_parse_dest]+present} ]]; then
            if [[ ${__koi_arg_kinds[$__koi_parse_dest]} == flag ]]; then
                __koi_parse_values[$__koi_parse_dest]=0
            else
                __koi_parse_values[$__koi_parse_dest]=${__koi_arg_defaults[$__koi_parse_dest]-}
            fi
        fi

        # only plain/exported scalars can preserve arbitrary literal values
        if __koi_parse_declaration=$(declare -p "$__koi_parse_dest" 2>/dev/null); then
            __koi_parse_attributes=${__koi_parse_declaration#declare -}
            __koi_parse_attributes=${__koi_parse_attributes%% *}
            if [[ $__koi_parse_attributes != - && $__koi_parse_attributes != x ]]; then
                __koi_error "__parseargs: incompatible destination: '$__koi_parse_dest'"
                return 2
            fi
        fi
    done

    # assign only after every value and destination has been checked
    for __koi_parse_dest in "${__koi_args[@]}"; do
        if ! printf -v "$__koi_parse_dest" '%s' "${__koi_parse_values[$__koi_parse_dest]}"; then
            # in the rare case that we couldn't assign the destination's value
            __koi_error "__parseargs: cannot assign destination: '$__koi_parse_dest'"
            return 2
        fi
    done

    # signal prepared dispatch so the caller can discard the spec before execution
    if [[ -n $__koi_engine_handler ]]; then
        return 3
    fi
    return 0
}

# Print formatted error to stderr
# Usage: __koi_error $*
#   $*  the text to print
__koi_error() {
    printf 'koi: %s\n' "$*" >&2
    return 2
}

# Mark the current spec invalid and report a registration error immediately
# Usage: __koi_spec_error PREFIX "$@"
#   PREFIX  owning registration buffer prefix
#   $@      diagnostic text
# Returns 2
__koi_spec_error() {
    local -n __koi_error_valid="${1}_spec_valid"
    shift
    __koi_error_valid=0
    __koi_error "$@"
    return 2
}

# Validate an argument destination without modifying the registry
# Usage: __koi_validate_arg_destination PREFIX DEST
#   PREFIX  registration buffer prefix
#   DEST    the destination identifier to validate
# Returns 2 and marks the spec invalid on failure
__koi_validate_arg_destination() {
    local __koi_validation_prefix=$1
    local __koi_validation_dest=$2 __koi_reserved
    local -a __koi_reserved_names=(
        BASH BASH_ENV BASH_SUBSHELL BASHPID BASH_VERSINFO BASH_VERSION CDPATH
        DIRSTACK EDITOR EUID FUNCNAME GLOBIGNORE GROUPS HOME HOSTNAME
        HOSTTYPE IFS IGNOREEOF LC_COLLATE LC_CTYPE LINENO MACHTYPE OLDPWD
        OSTYPE PATH PIPESTATUS PPID PROMPT_COMMAND PS1 PS2 PS3 PS4 PWD
        REPLY SECONDS SHELLOPTS SHLVL TMOUT UID koi_status
    )

    if [[ ! $__koi_validation_dest =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ || $__koi_validation_dest == __koi_* ]]; then
        __koi_spec_error "$__koi_validation_prefix" "__addarg: invalid destination: '$__koi_validation_dest'"
        return 2
    fi

    for __koi_reserved in "${__koi_reserved_names[@]}"; do
        if [[ $__koi_validation_dest == "$__koi_reserved" ]]; then
            __koi_spec_error "$__koi_validation_prefix" "__addarg: reserved destination: '$__koi_validation_dest'"
            return 2
        fi
    done
    return 0
}

# Validate completed argument metadata and check for registration collisions
# Usage: __koi_validate_arg_spec PREFIX DEST VALUES_ARRAY SEEN_ARRAY
#   PREFIX        registration buffer prefix
#   DEST          the validated destination identifier
#   VALUES_ARRAY  the name of the associative declaration-value array
#   SEEN_ARRAY    the name of the associative parameter-presence array
# Returns 2 and marks the spec invalid on failure, does not modify metadata
__koi_validate_arg_spec() {
    local __koi_validation_prefix=$1
    local -n __koi_args="${__koi_validation_prefix}_args"
    local -n __koi_arg_shorts="${__koi_validation_prefix}_arg_shorts"
    local -n __koi_arg_longs="${__koi_validation_prefix}_arg_longs"
    local -n __koi_arg_kinds="${__koi_validation_prefix}_arg_kinds"
    local __koi_validation_dest=$2 __koi_validation_existing __koi_validation_reserved
    local -n __koi_validation_values=$3 __koi_validation_seen=$4

    if [[ -z ${__koi_validation_values[kind]} ]]; then
        __koi_spec_error "$__koi_validation_prefix" '__addarg: exactly one of --flag, --option, or --positional is required'
        return 2
    fi

    if [[ -z ${__koi_validation_values[description]} ]]; then
        __koi_spec_error "$__koi_validation_prefix" '__addarg: nonempty description required'
        return 2
    fi

    if [[ ${__koi_validation_values[kind]} == positional ]]; then
        if [[ ${__koi_validation_seen[short]+present} || ${__koi_validation_seen[long]+present} ]]; then
            __koi_spec_error "$__koi_validation_prefix" '__addarg: positionals cannot have short or long spellings'
            return 2
        fi
    elif [[ ! ${__koi_validation_seen[short]+present} && ! ${__koi_validation_seen[long]+present} ]]; then
        __koi_spec_error "$__koi_validation_prefix" '__addarg: short or long spelling required'
        return 2
    fi

    if [[ ${__koi_validation_seen[short]+present} ]]; then
        if [[ ! ${__koi_validation_values[short]} =~ ^[a-zA-Z]$ || ${__koi_validation_values[short]} == h ]]; then
            __koi_spec_error "$__koi_validation_prefix" "__addarg: invalid or reserved short spelling: '${__koi_validation_values[short]}'"
            return 2
        fi
    fi

    if [[ ${__koi_validation_seen[long]+present} ]]; then
        if [[ ! ${__koi_validation_values[long]} =~ ^[a-zA-Z][a-zA-Z0-9_-]*$ ]]; then
            __koi_spec_error "$__koi_validation_prefix" "__addarg: invalid or reserved long spelling: '${__koi_validation_values[long]}'"
            return 2
        fi
        for __koi_validation_reserved in "${__koi_reserved_longs[@]}"; do
            if [[ ${__koi_validation_values[long]} == "$__koi_validation_reserved" ]]; then
                __koi_spec_error "$__koi_validation_prefix" "__addarg: invalid or reserved long spelling: '${__koi_validation_values[long]}'"
                return 2
            fi
        done
    fi

    if [[ ${__koi_validation_seen[display_name]+present} ]]; then
        if [[ ${__koi_validation_values[kind]} == flag || -z ${__koi_validation_values[display_name]} ]]; then
            __koi_spec_error "$__koi_validation_prefix" '__addarg: nonempty display name requires an option or positional'
            return 2
        fi
    fi

    if [[ ${__koi_validation_seen[default]+present} ]]; then
        if [[ ${__koi_validation_values[kind]} == flag || ${__koi_validation_values[required]} == 1 ]]; then
            __koi_spec_error "$__koi_validation_prefix" '__addarg: defaults require an optional option or positional'
            return 2
        fi
    fi

    if [[ ${__koi_arg_kinds[$__koi_validation_dest]+present} ]]; then
        __koi_spec_error "$__koi_validation_prefix" "__addarg: duplicate destination: '$__koi_validation_dest'"
        return 2
    fi

    for __koi_validation_existing in "${__koi_args[@]}"; do
        if [[ -n ${__koi_validation_values[short]} && ${__koi_validation_values[short]} == "${__koi_arg_shorts[$__koi_validation_existing]}" ]]; then
            __koi_spec_error "$__koi_validation_prefix" "__addarg: duplicate short spelling: '${__koi_validation_values[short]}'"
            return 2
        fi
        if [[ -n ${__koi_validation_values[long]} && ${__koi_validation_values[long]} == "${__koi_arg_longs[$__koi_validation_existing]}" ]]; then
            __koi_spec_error "$__koi_validation_prefix" "__addarg: duplicate long spelling: '${__koi_validation_values[long]}'"
            return 2
        fi
    done
    return 0
}

# Validate positional layout and derive local help availability
# Usage: __koi_finalize_spec PREFIX
#   PREFIX  consumed spec prefix
# Returns 2 for invalid layouts, including during help or inspection
__koi_finalize_spec() {
    local __koi_layout_prefix=$1 __koi_layout_dest __koi_layout_optional=0
    local -n __koi_layout_args="${__koi_layout_prefix}_args"
    local -n __koi_layout_kinds="${__koi_layout_prefix}_arg_kinds"
    local -n __koi_layout_requireds="${__koi_layout_prefix}_arg_requireds"
    local -n __koi_layout_commands="${__koi_layout_prefix}_commands"
    local -n __koi_layout_meta="${__koi_layout_prefix}_meta"
    __koi_layout_meta[positionals]=0

    # inspect positionals in declaration order, ignoring named arguments
    for __koi_layout_dest in "${__koi_layout_args[@]}"; do
        if [[ ${__koi_layout_kinds[$__koi_layout_dest]} != positional ]]; then
            continue
        fi
    
        # count positional slots and reject required slots after optional ones
        __koi_layout_meta[positionals]=$((__koi_layout_meta[positionals] + 1))
        if [[ ${__koi_layout_requireds[$__koi_layout_dest]} == 1 ]]; then
            if (( __koi_layout_optional )); then
                __koi_error '__parseargs: required positionals must precede optional positionals'
                return 2
            fi
        else
            __koi_layout_optional=1
        fi
    done

    # reserve bare tokens for child selection in contexts with application commands
    if (( __koi_layout_meta[positionals] )); then
        if (( ${#__koi_layout_commands[@]} )); then
            __koi_error '__parseargs: positionals cannot coexist with application child commands'
            return 2
        fi
    fi

    # offer free help commands only in branches with application children
    if (( ${#__koi_layout_commands[@]} == 0 )); then
        __koi_layout_meta[builtin]=0
        __koi_layout_meta[verbose]=0
    fi

    return 0
}

# Scan script tokens into temporary values while allowing help to override errors
# Usage: __koi_scan_args PREFIX VALUES_ARRAY SEEN_ARRAY ERROR_VAR TAIL_ARRAY ROOT "$@"
#   PREFIX        parser-local spec prefix
#   VALUES_ARRAY  associative output array of supplied values
#   SEEN_ARRAY    associative output array tracking explicit presence
#   ERROR_VAR     first input diagnostic, or empty text
#   TAIL_ARRAY    receives the child command and remaining tokens
#   ROOT          1 to recognize a command even with no registered children
#   $@            script arguments, including koi-reserved parser settings
# Returns 1 for help or 0 after scanning without assigning user destinations
# namerefs point to associative arrays whose keys require string expansion
# shellcheck disable=SC2004
__koi_scan_args() {
    local __koi_scan_prefix=$1
    local -n __koi_commands="${__koi_scan_prefix}_commands"
    local -n __koi_args="${__koi_scan_prefix}_args"
    local -n __koi_arg_shorts="${__koi_scan_prefix}_arg_shorts"
    local -n __koi_arg_longs="${__koi_scan_prefix}_arg_longs"
    local -n __koi_arg_kinds="${__koi_scan_prefix}_arg_kinds"
    local -n __koi_scan_meta="${__koi_scan_prefix}_meta"
    local -n __koi_scan_values=$2 __koi_scan_seen=$3 __koi_scan_error=$4 __koi_scan_tail=$5
    local __koi_scan_root=$6
    local __koi_scan_duplicates=0 __koi_scan_duplicate=''
    shift 6

    local __koi_scan_dest __koi_scan_token __koi_scan_value __koi_scan_char
    local __koi_scan_index __koi_scan_cluster_valid __koi_scan_cluster_help
    local __koi_scan_positional=0 __koi_scan_slot=0
    local -a __koi_scan_positionals=()
    local -A __koi_scan_lookup=()
    local -a __koi_scan_cluster=()

    # map spellings and preserve positional declaration order separately
    for __koi_scan_dest in "${__koi_args[@]}"; do
        if [[ ${__koi_arg_kinds[$__koi_scan_dest]} == positional ]]; then
            __koi_scan_positionals+=("$__koi_scan_dest")
        fi

        if [[ -n ${__koi_arg_shorts[$__koi_scan_dest]} ]]; then
            __koi_scan_lookup[-${__koi_arg_shorts[$__koi_scan_dest]}]=$__koi_scan_dest
        fi

        if [[ -n ${__koi_arg_longs[$__koi_scan_dest]} ]]; then
            __koi_scan_lookup[--${__koi_arg_longs[$__koi_scan_dest]}]=$__koi_scan_dest
        fi
    done

    # keep the first error but continue looking for a help request
    while (( $# )); do
        __koi_scan_token=$1
        shift

        if (( __koi_scan_root || ${#__koi_commands[@]} || __koi_scan_meta[builtin] )) &&
            { (( __koi_scan_positional )) || [[ $__koi_scan_token != -* ]]; }; then
            # forward the selected command and its remaining tokens without parsing them
            __koi_scan_tail=("$__koi_scan_token" "$@")
            break
        elif (( __koi_scan_positional )) || [[ $__koi_scan_token != -* || $__koi_scan_token == - ]]; then
            # fill the next positional slot with bare data or any token after --
            if (( __koi_scan_slot < ${#__koi_scan_positionals[@]} )); then
                __koi_scan_dest=${__koi_scan_positionals[$__koi_scan_slot]}
                __koi_scan_slot=$((__koi_scan_slot + 1))
                __koi_scan_values[$__koi_scan_dest]=$__koi_scan_token
                __koi_scan_seen[$__koi_scan_dest]=1
            elif [[ -z $__koi_scan_error ]]; then
                __koi_scan_error="unsupported positional argument: '$__koi_scan_token'"
            fi
        elif [[ $__koi_scan_token == -h || $__koi_scan_token == --help ]]; then
            # stop scanning and request help
            return 1
        elif [[ $__koi_scan_token == -- ]]; then
            # end option recognition for the remaining tokens
            __koi_scan_positional=1
        elif [[ $__koi_scan_token == --koi-error-on-duplicates ]]; then
            # enable strict duplicate checking
            if (( __koi_scan_duplicates )) && [[ -z $__koi_scan_error ]]; then
                __koi_scan_error='repeated --koi-error-on-duplicates setting'
            fi
            __koi_scan_duplicates=1
        elif [[ -n $__koi_scan_token && ${__koi_scan_lookup[$__koi_scan_token]+present} ]]; then
            # resolve an exact spelling to its destination and value
            __koi_scan_dest=${__koi_scan_lookup[$__koi_scan_token]}
            __koi_scan_value=1
            if [[ ${__koi_arg_kinds[$__koi_scan_dest]} == option ]]; then
                # options consume a value instead of storing 1
                if (( $# == 0 )); then
                    # reject an option with no remaining value token
                    if [[ -z $__koi_scan_error ]]; then
                        __koi_scan_error="missing value for '$__koi_scan_token'"
                    fi
                    continue
                fi

                if [[ $1 == -h || $1 == --help ]]; then
                    # help overrides an apparent option value
                    return 1
                fi

                # consume the next token literally, except for help
                __koi_scan_value=$1
                shift
            fi

            if [[ ${__koi_scan_seen[$__koi_scan_dest]+present} && -z $__koi_scan_duplicate ]]; then
                # remember the first repeated destination
                __koi_scan_duplicate=$__koi_scan_dest
            fi
            __koi_scan_values[$__koi_scan_dest]=$__koi_scan_value
            __koi_scan_seen[$__koi_scan_dest]=1
        elif [[ $__koi_scan_token == -?* && $__koi_scan_token != --* && ${#__koi_scan_token} -gt 2 ]]; then
            # validate the whole cluster before accepting any of its flags
            __koi_scan_cluster=()
            __koi_scan_cluster_valid=1
            __koi_scan_cluster_help=0

            for (( __koi_scan_index=1; __koi_scan_index < ${#__koi_scan_token}; __koi_scan_index++ )); do
                __koi_scan_char=${__koi_scan_token:__koi_scan_index:1}
                if [[ $__koi_scan_char == h ]]; then
                    # defer clustered help until the whole cluster is valid
                    __koi_scan_cluster_help=1
                elif [[ ${__koi_scan_lookup[-$__koi_scan_char]+present} ]]; then
                    # resolve this cluster member to a registered argument
                    __koi_scan_dest=${__koi_scan_lookup[-$__koi_scan_char]}
                    if [[ ${__koi_arg_kinds[$__koi_scan_dest]} != flag ]]; then
                        # value-taking options cannot appear in clusters
                        __koi_scan_cluster_valid=0
                    fi
                    __koi_scan_cluster+=("$__koi_scan_dest")
                else
                    # unknown letters make the whole cluster invalid
                    __koi_scan_cluster_valid=0
                fi
            done

            if (( ! __koi_scan_cluster_valid )); then
                # reject the cluster without accepting any members
                if [[ -z $__koi_scan_error ]]; then
                    __koi_scan_error="invalid or ambiguous short cluster: '$__koi_scan_token' (flags only)"
                fi
                continue
            fi

            if (( __koi_scan_cluster_help )); then
                # request help from a valid flags-only cluster
                return 1
            fi

            for __koi_scan_dest in "${__koi_scan_cluster[@]}"; do
                if [[ ${__koi_scan_seen[$__koi_scan_dest]+present} && -z $__koi_scan_duplicate ]]; then
                    # track duplicates within clusters and across spellings
                    __koi_scan_duplicate=$__koi_scan_dest
                fi
                __koi_scan_values[$__koi_scan_dest]=1
                __koi_scan_seen[$__koi_scan_dest]=1
            done
        else
            # reject tokens that match neither an option nor a valid cluster
            if [[ -z $__koi_scan_error ]]; then
                __koi_scan_error="unsupported positional argument: '$__koi_scan_token'"
            fi
        fi
    done

    # the reserved setting can appear after the duplicate it should reject
    if (( __koi_scan_duplicates )) && [[ -n $__koi_scan_duplicate && -z $__koi_scan_error ]]; then
        __koi_scan_error="duplicate argument: '$__koi_scan_duplicate'"
    fi
    return 0
}

# Print a runner diagnostic with the invoking script's name
# Usage: __koi_run_error "$@"
#   $@  the diagnostic text
__koi_run_error() {
    printf '%s: %s\n' "${__koi_config[name]:-${0##*/}}" "$*" >&2
    return 2
}

# Print immediate children commands without entering their handlers
# Usage: __koi_print_commands PREFIX
#   PREFIX  parser-local spec prefix
__koi_print_commands() {
    local __koi_command_prefix=$1
    local -n __koi_commands="${__koi_command_prefix}_commands"
    local -n __koi_descriptions="${__koi_command_prefix}_descriptions"
    local -n __koi_command_meta="${__koi_command_prefix}_meta"
    local -a __koi_command_names=("${__koi_commands[@]}")
    if (( __koi_command_meta[builtin] )); then
        __koi_command_names+=(help)
    fi
    local __koi_root_command __koi_root_description __koi_root_indent __koi_root_first
    local __koi_root_width=0
    for __koi_root_command in "${__koi_command_names[@]}"; do
        if (( ${#__koi_root_command} > __koi_root_width )); then
            __koi_root_width=${#__koi_root_command}
        fi
    done
    printf -v __koi_root_indent '%*s' "$((__koi_root_width + 4))" ''
    printf '\n\nCommands:\n'
    for __koi_root_command in "${__koi_command_names[@]}"; do
        if [[ $__koi_root_command == help ]] && (( __koi_command_meta[builtin] )); then
            __koi_root_description='Show this help'
        else
            __koi_root_description=${__koi_descriptions[$__koi_root_command]}
        fi
        printf -v __koi_root_first '  %-*s  ' "$__koi_root_width" "$__koi_root_command"
        __koi_wrap "$__koi_root_description" "$__koi_root_first" "$__koi_root_indent"
    done
}

# Print help for a consumed spec and its immediate children
# Usage: __koi_print_help PREFIX ROOT PATH
#   PREFIX  parser-local spec prefix
#   ROOT    1 for root command usage, otherwise 0
#   PATH    CLI command path, or empty for direct calls
__koi_print_help() {
    local __koi_help_prefix=$1 __koi_help_root=$2 __koi_help_path=$3
    local -n __koi_commands="${__koi_help_prefix}_commands"
    local -n __koi_help_meta="${__koi_help_prefix}_meta"
    local -n __koi_args="${__koi_help_prefix}_args"
    local -n __koi_arg_shorts="${__koi_help_prefix}_arg_shorts"
    local -n __koi_arg_longs="${__koi_help_prefix}_arg_longs"
    local -n __koi_arg_kinds="${__koi_help_prefix}_arg_kinds"
    local -n __koi_arg_descriptions="${__koi_help_prefix}_arg_descriptions"
    local -n __koi_arg_requireds="${__koi_help_prefix}_arg_requireds"
    local -n __koi_arg_defaults="${__koi_help_prefix}_arg_defaults"
    local -n __koi_arg_display_names="${__koi_help_prefix}_arg_display_names"
    local __koi_help_dest __koi_help_spelling __koi_help_usage __koi_help_width
    local __koi_help_value __koi_help_description __koi_help_indent
    local -a __koi_help_labels=('-h, --help')
    __koi_help_width=${#__koi_help_labels[0]}
    local __koi_help_index=1 __koi_help_positional_section=0
    local -a __koi_help_order=()

    # show flags and options first while preserving their declaration order
    for __koi_help_dest in "${__koi_args[@]}"; do
        if [[ ${__koi_arg_kinds[$__koi_help_dest]} != positional ]]; then
            __koi_help_order+=("$__koi_help_dest")
        fi
    done

    # append positionals in the order their values are consumed
    for __koi_help_dest in "${__koi_args[@]}"; do
        if [[ ${__koi_arg_kinds[$__koi_help_dest]} == positional ]]; then
            __koi_help_order+=("$__koi_help_dest")
        fi
    done

    if [[ -n ${__koi_help_meta[description]-} ]]; then
        __koi_wrap "${__koi_help_meta[description]}" '' ''
        printf '\n'
    fi
    printf 'Usage: %s' "${__koi_help_meta[name]}"
    if [[ -n $__koi_help_path ]]; then
        printf ' %s' "$__koi_help_path"
    fi
    printf ' [-h]'

    for __koi_help_dest in "${__koi_help_order[@]}"; do
        # prefer short spelling in usage, fall back to long if absent
        if [[ -n ${__koi_arg_shorts[$__koi_help_dest]} ]]; then
            __koi_help_usage=-${__koi_arg_shorts[$__koi_help_dest]}
        else
            __koi_help_usage=--${__koi_arg_longs[$__koi_help_dest]}
        fi

        # uppercase the display name, falling back to long spelling then destination
        __koi_help_value=${__koi_arg_display_names[$__koi_help_dest]:-${__koi_arg_longs[$__koi_help_dest]:-$__koi_help_dest}}
        __koi_help_value=${__koi_help_value^^}
        if [[ ${__koi_arg_kinds[$__koi_help_dest]} == positional ]]; then
            __koi_help_usage=$__koi_help_value
        elif [[ ${__koi_arg_kinds[$__koi_help_dest]} == option ]]; then
            __koi_help_usage+=" $__koi_help_value"
        fi

        # bracket optional arguments and leave required arguments unbracketed
        if [[ ${__koi_arg_requireds[$__koi_help_dest]} == 1 ]]; then
            printf ' %s' "$__koi_help_usage"
        else
            printf ' [%s]' "$__koi_help_usage"
        fi

        # start the options-table label with the short spelling if present
        __koi_help_spelling=''
        if [[ -n ${__koi_arg_shorts[$__koi_help_dest]} ]]; then
            __koi_help_spelling=-${__koi_arg_shorts[$__koi_help_dest]}
        fi

        # append the long spelling, separating aliases with a comma
        if [[ -n ${__koi_arg_longs[$__koi_help_dest]} ]]; then
            if [[ -n $__koi_help_spelling ]]; then
                __koi_help_spelling+=', '
            fi
            __koi_help_spelling+=--${__koi_arg_longs[$__koi_help_dest]}
        fi

        # append a value label for options but not flags
        if [[ ${__koi_arg_kinds[$__koi_help_dest]} == positional ]]; then
            __koi_help_spelling=$__koi_help_value
        elif [[ ${__koi_arg_kinds[$__koi_help_dest]} == option ]]; then
            __koi_help_spelling+=" $__koi_help_value"
        fi

        # save the label and track the widest row for description alignment
        __koi_help_labels+=("$__koi_help_spelling")
        if (( ${#__koi_help_spelling} > __koi_help_width )); then
            __koi_help_width=${#__koi_help_spelling}
        fi
    done

    if (( ${#__koi_commands[@]} )); then
        printf ' COMMAND'
    fi

    printf -v __koi_help_indent '%*s' "$((__koi_help_width + 4))" ''
    if (( ${#__koi_commands[@]} || __koi_help_meta[builtin] )); then
        __koi_print_commands "$__koi_help_prefix"
        printf '\nOptions:\n'
    else
        printf '\n\nOptions:\n'
    fi

    printf '  %-*s  %s\n' "$__koi_help_width" "${__koi_help_labels[0]}" 'Show this help'
    for __koi_help_dest in "${__koi_help_order[@]}"; do
        if [[ ${__koi_arg_kinds[$__koi_help_dest]} == positional ]] && (( ! __koi_help_positional_section )); then
            printf '\nPositionals:\n'
            __koi_help_positional_section=1
        fi

        __koi_help_description=${__koi_arg_descriptions[$__koi_help_dest]}
        if [[ ${__koi_arg_requireds[$__koi_help_dest]} == 1 ]]; then
            __koi_help_description+=' (required)'
        fi

        if [[ ${__koi_arg_defaults[$__koi_help_dest]+present} ]]; then
            __koi_help_description+=" (default: ${__koi_arg_defaults[$__koi_help_dest]})"
        fi

        local __koi_help_first
        printf -v __koi_help_first '  %-*s  ' "$__koi_help_width" "${__koi_help_labels[$__koi_help_index]}"
        __koi_wrap "$__koi_help_description" "$__koi_help_first" "$__koi_help_indent"
        __koi_help_index=$((__koi_help_index + 1))
    done

    if (( __koi_help_root && __koi_help_meta[hints] )) &&
        (( __koi_help_meta[verbose] || ${#__koi_commands[@]} )); then
        printf '\nHints:\n'
        if (( __koi_help_meta[verbose] )); then
            printf '  %s help --verbose    Show complete command documentation\n' "${__koi_help_meta[name]}"
        fi
        if (( ${#__koi_commands[@]} )); then
            printf '  %s COMMAND --help    Show individual command documentation\n' "${__koi_help_meta[name]}"
        fi
    fi
}

# ------------------ CONTROL FLOW ------------------

# prevent usage below Bash 5.2
__koi_bash_major_version=5
__koi_bash_minor_version=2
__koi_bash_version="${__koi_bash_major_version}.${__koi_bash_minor_version}"

if [ -z "${BASH_VERSION-}" ]; then
    __koi_error "requires Bash >= $__koi_bash_version"
    return 2
fi
if (( BASH_VERSINFO[0] < __koi_bash_major_version ||
      (BASH_VERSINFO[0] == __koi_bash_major_version && BASH_VERSINFO[1] < __koi_bash_minor_version) )); then
    __koi_error "requires Bash >= $__koi_bash_version"
    return 2
fi

# Re-sourcing preserves both unfinished registration and the root lifecycle
if [[ ${__koi_initialized-} != 1 ]]; then
    declare -ga __koi_spec_fields=(commands handlers descriptions args arg_shorts arg_longs arg_kinds arg_descriptions arg_requireds arg_defaults arg_display_names meta)
    declare -ga __koi_root_commands=()
    declare -gA __koi_root_handlers=()
    declare -gA __koi_root_descriptions=()
    declare -ga __koi_root_args=()
    declare -gA __koi_root_arg_shorts=()
    declare -gA __koi_root_arg_longs=()
    declare -gA __koi_root_arg_kinds=()
    declare -gA __koi_root_arg_descriptions=()
    declare -gA __koi_root_arg_requireds=()
    declare -gA __koi_root_arg_defaults=()
    declare -gA __koi_root_arg_display_names=()
    declare -gA __koi_config=()
    declare -gA __koi_root_meta=()
    declare -gi __koi_root_spec_valid=1
    declare -ga __koi_pending_commands=()
    declare -gA __koi_pending_handlers=()
    declare -gA __koi_pending_descriptions=()
    declare -ga __koi_pending_args=()
    declare -gA __koi_pending_arg_shorts=()
    declare -gA __koi_pending_arg_longs=()
    declare -gA __koi_pending_arg_kinds=()
    declare -gA __koi_pending_arg_descriptions=()
    declare -gA __koi_pending_arg_requireds=()
    declare -gA __koi_pending_arg_defaults=()
    declare -gA __koi_pending_arg_display_names=()
    declare -gA __koi_pending_meta=()
    declare -gi __koi_pending_spec_valid=1
    declare -gi __koi_root_used=0
    declare -ga __koi_reserved_longs=(help koi-error-on-duplicates koi-error-on-duplicate koi-inspect)
    # shellcheck disable=SC2034
    declare -g koi_status=0
    __koi_initialized=1
fi
